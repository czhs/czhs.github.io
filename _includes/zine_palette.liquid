{%- comment -%}
  Palette assignment for the zine design.

  Everyone starts on seafoam. A visitor who picks another palette from the
  circles at the bottom of the homepage (_includes/zine_picker.liquid) keeps it:
  stored in a cookie (1 year) with a localStorage mirror, refreshed each visit.

  This include lives in <head> — inside _layouts/default.liquid only, so MLn,
  ringworld and the portfolio (their own *_base.liquid shells) never see it. The
  script runs before first paint so there is no flash of the wrong palette.

  Every palette obeys one formula:
    field  dusty mid-tone, S 18-28% / L 58-66% — the ground cards sit on
    ink    that hue driven to near-black — text, borders, terminal ground
    card   near-white tinted OPPOSITE the ink, so cards read as lit
    claude Claude's insertions, inverted warm/cool against the card
{%- endcomment -%}

<script>
  (function () {
    var PALS = ['wisteria', 'lilac-ash', 'clay', 'puce', 'slate-teal', 'seafoam', 'denim'];
    var KEY = 'zine-pal';
    var DEFAULT_PAL = 'seafoam';

    function readCookie(n) {
      var m = document.cookie.match('(?:^|; )' + n + '=([^;]*)');
      return m ? decodeURIComponent(m[1]) : null;
    }

    var v = readCookie(KEY);
    if (!v) { try { v = localStorage.getItem(KEY); } catch (e) {} }
    // Everyone starts on seafoam; the picker on the homepage is what changes it.
    if (!v || PALS.indexOf(v) < 0) { v = DEFAULT_PAL; }

    // refresh the cookie on every visit so an active reader never ages out
    document.cookie = KEY + '=' + encodeURIComponent(v) + ';path=/;max-age=31536000;samesite=lax';
    try { localStorage.setItem(KEY, v); } catch (e) {}

    document.documentElement.setAttribute('data-pal', v);
    window.ZINE_PALS = PALS;

    // Suppress every transition/animation until the first frame is painted, so
    // arriving on a page is a cut, not a drift. Anything that would otherwise
    // animate from its initial value on load (back-to-top sliding up, elements
    // easing in as scripts initialise) simply starts where it belongs.
    //
    // The removal must NOT depend on requestAnimationFrame alone: rAF does not
    // run in a backgrounded tab, so a page opened in the background kept the
    // class forever and every transition on the site stayed dead — including
    // hover effects — even after the reader switched to it. rAF is still the
    // preferred path (it lands on the very next frame); the timeout is a
    // backstop that always fires.
    var root = document.documentElement;
    root.classList.add('zine-preload');
    var settled = false;
    function settle() {
      if (settled) return;
      settled = true;
      root.classList.remove('zine-preload');
    }
    function settleSoon() { requestAnimationFrame(settle); }
    if (document.readyState === 'complete') settleSoon();
    else window.addEventListener('load', settleSoon, { once: true });
    document.addEventListener('DOMContentLoaded', settleSoon, { once: true });
    setTimeout(settle, 500);
  })();
</script>

{%- comment -%}
  Fonts are self-hosted (both are OFL, so this is permitted) rather than pulled
  from Google Fonts. Three reasons, in order of how much they mattered:

  1. The swap reflow. A webfont arriving after first paint re-lays out every
     line, which is the "content shifts down a few lines and re-renders as it
     goes" effect. Preloading a same-origin file gets it there before the first
     paint instead of two hops later (CSS on googleapis -> font on gstatic).
  2. It removes a render-blocking third-party stylesheet from the critical path.
  3. Latin-subset variable files: 27 KB + 31 KB covers every weight we use.

  Italics are synthesised from the variable face — the italic file was dropped
  because the notebook uses <em> sparingly and it is not worth a second
  download.
{%- endcomment -%}
<link rel="preload" as="font" type="font/woff2" crossorigin
      href="{{ '/assets/fonts/plus-jakarta-sans-latin-var.woff2' | relative_url }}">
<link rel="preload" as="font" type="font/woff2" crossorigin
      href="{{ '/assets/fonts/jetbrains-mono-latin-var.woff2' | relative_url }}">

{%- comment -%}
  Figtree (OFL, same terms as the two above) is the face the /research card's
  design is taken from — see the credit in the site footer. Same nominal sizes
  in a different face do not read as the same size: Figtree's x-height is
  500/1000 against Plus Jakarta Sans's 536, so the card was rendering visibly
  larger than the layout it copies. Emitted on /research only; every other page
  would download it for nothing.
{%- endcomment -%}
{% assign rzine_page = false %}
{% if page.layout contains 'research' or page.rzine %}
  {% assign rzine_page = true %}
{% endif %}
{% if rzine_page %}
  <link rel="preload" as="font" type="font/woff2" crossorigin
        href="{{ '/assets/fonts/figtree-latin-var.woff2' | relative_url }}">
  <style>
    @font-face {
      font-family: 'Figtree';
      font-style: normal;
      font-weight: 300 900;
      font-display: swap;
      src: url('{{ '/assets/fonts/figtree-latin-var.woff2' | relative_url }}') format('woff2');
    }

    /* Metric-matched fallback, measured in-browser against Arial the same way
       the two faces below were: Figtree runs 100.25% of Arial's advance width,
       so the overrides are its own 950/250 ascent and descent divided by that
       size adjustment. */
    @font-face {
      font-family: 'Figtree Fallback';
      src: local('Arial'), local('Helvetica'), local('Liberation Sans');
      size-adjust: 100.25%;
      ascent-override: 94.76%;
      descent-override: 24.94%;
      line-gap-override: 0%;
    }
  </style>
{% endif %}

<style>
  @font-face {
    font-family: 'Plus Jakarta Sans';
    font-style: normal;
    font-weight: 200 800;
    font-display: swap;
    src: url('{{ '/assets/fonts/plus-jakarta-sans-latin-var.woff2' | relative_url }}') format('woff2');
  }

  @font-face {
    font-family: 'JetBrains Mono';
    font-style: normal;
    font-weight: 100 800;
    font-display: swap;
    src: url('{{ '/assets/fonts/jetbrains-mono-latin-var.woff2' | relative_url }}') format('woff2');
  }

  /* Metric-matched fallbacks.
     Preloading gets the real fonts in early, but if they are ever late the
     swap must not move anything. Plus Jakarta Sans is 6.07% wider than Arial
     and has a 1.26 line box against Arial's 1.15 — enough that text rewraps
     to a different number of lines and everything below it jumps. These faces
     stretch the local fallback onto Plus Jakarta Sans's metrics, so the swap
     is invisible. Arial is the reference because it is present on macOS and
     Windows and maps to the metric-compatible Liberation Sans on Linux.
     Measured in-browser, not guessed. */
  @font-face {
    font-family: 'PJS Fallback';
    src: local('Arial'), local('Helvetica'), local('Liberation Sans');
    size-adjust: 106.07%;
    /* These are relative to the SIZE-ADJUSTED em, so the target 100%/26% is
       divided by 1.0607 — setting them directly overshot the line box by 6%. */
    ascent-override: 94.28%;
    descent-override: 24.51%;
    line-gap-override: 0%;
  }

  @font-face {
    font-family: 'JBM Fallback';
    src: local('Menlo'), local('Consolas'), local('DejaVu Sans Mono'), local('Courier New');
    size-adjust: 100%;
    ascent-override: 102%;
    descent-override: 30%;
    line-gap-override: 0%;
  }
</style>

<style>
  /* Default, and the no-JS fallback: seafoam. data-pal overrides it once a
     visitor picks something else. */
  :root,
  html[data-pal='seafoam'] {
    --rz-field: #8fb2a4;
    --rz-ink: #13261f;
    --rz-card: #fffcf2;
    --rz-chrome: #d3e0d9;
    --rz-accent: #0f6046;
    --rz-claude-ink: #8a3f10;
    --rz-claude-bg: #edf5f1;
  }

  html[data-pal='wisteria'] {
    --rz-field: #8e9bc4;
    --rz-ink: #141b38;
    --rz-card: #fffcf4;
    --rz-chrome: #d5d8e4;
    --rz-accent: #3a4d9c;
    --rz-claude-ink: #9c4510;
    --rz-claude-bg: #f0f2fb;
  }

  html[data-pal='lilac-ash'] {
    --rz-field: #a296b8;
    --rz-ink: #221b33;
    --rz-card: #fffcf3;
    --rz-chrome: #dbd6e0;
    --rz-accent: #5b4794;
    --rz-claude-ink: #9c4510;
    --rz-claude-bg: #f4f1f9;
  }

  html[data-pal='clay'] {
    --rz-field: #b0897f;
    --rz-ink: #2e1612;
    --rz-card: #fbfdff;
    --rz-chrome: #e2d6d2;
    --rz-accent: #1f5f8b;
    --rz-claude-ink: #1f5f8b;
    --rz-claude-bg: #fdf1ec;
  }

  html[data-pal='puce'] {
    --rz-field: #a8848f;
    --rz-ink: #2a1420;
    --rz-card: #fcfdff;
    --rz-chrome: #e0d2d6;
    --rz-accent: #1f6b53;
    --rz-claude-ink: #1f6b53;
    --rz-claude-bg: #fdf0f2;
  }

  html[data-pal='slate-teal'] {
    --rz-field: #7fa2a8;
    --rz-ink: #10262c;
    --rz-card: #fffbf2;
    --rz-chrome: #cfdbdd;
    --rz-accent: #0d5f6e;
    --rz-claude-ink: #9c4510;
    --rz-claude-bg: #eef6f7;
  }

  html[data-pal='denim'] {
    --rz-field: #8296ae;
    --rz-ink: #131f2b;
    --rz-card: #fffcf2;
    --rz-chrome: #d3dae2;
    --rz-accent: #1b5480;
    --rz-claude-ink: #8a4a12;
    --rz-claude-bg: #eef2f7;
  }

  :root {
    --rz-claude-line: color-mix(in srgb, var(--rz-ink) 16%, transparent);
    --rz-sans: 'Plus Jakarta Sans', 'PJS Fallback', 'Segoe UI', Roboto, sans-serif;
    --rz-mono: 'JetBrains Mono', 'JBM Fallback', ui-monospace, 'SF Mono', Menlo, Consolas, monospace;
  }

  /* paint the field behind the page before body styles resolve */
  html:has(body.zine) {
    background: var(--rz-field);
  }

  /* see zine-preload in the script above — no entry animations */
  html.zine-preload *,
  html.zine-preload *::before,
  html.zine-preload *::after {
    transition: none !important;
    animation: none !important;
  }

  /* The scrollbar appears on long pages and not on short ones, so navigating
     between them shifted the centred content sideways. Reserving the gutter
     keeps the measure fixed. */
  html {
    scrollbar-gutter: stable;
  }
</style>
