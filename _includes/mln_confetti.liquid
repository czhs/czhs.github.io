{%- comment -%}
  Celebratory confetti for symposium week. Self-contained (no libs). Bursts once
  on load, settles, then removes itself. Honors prefers-reduced-motion. Included
  from _pages/mln.html and _layouts/mln.liquid only when the relevant week has
  `symposium: true`. A small 🎉 button lets folks replay the burst.
{%- endcomment -%}
<button type="button" class="mln-confetti-replay" aria-label="Replay confetti">🎉</button>
<script>
(function () {
  var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  var COLORS = ['#ff5d8f', '#ffd166', '#06d6a0', '#4d96ff', '#c77dff', '#ff924c'];
  var canvas, ctx, pieces = [], raf = null, endAt = 0;

  function ensureCanvas() {
    if (canvas) return;
    canvas = document.createElement('canvas');
    canvas.className = 'mln-confetti-canvas';
    document.body.appendChild(canvas);
    ctx = canvas.getContext('2d');
    resize();
    window.addEventListener('resize', resize);
  }
  function resize() {
    if (!canvas) return;
    var dpr = window.devicePixelRatio || 1;
    canvas.width = window.innerWidth * dpr;
    canvas.height = window.innerHeight * dpr;
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
  }
  function rand(a, b) { return a + Math.random() * (b - a); }

  function spawn(n) {
    var w = window.innerWidth;
    for (var i = 0; i < n; i++) {
      pieces.push({
        x: rand(0, w),
        y: rand(-60, -10),
        r: rand(4, 9),
        vx: rand(-1.2, 1.2),
        vy: rand(2.2, 5.2),
        rot: rand(0, Math.PI * 2),
        vr: rand(-0.2, 0.2),
        color: COLORS[(Math.random() * COLORS.length) | 0]
      });
    }
  }

  function tick(now) {
    ctx.clearRect(0, 0, canvas.width, canvas.height);
    var h = window.innerHeight;
    for (var i = pieces.length - 1; i >= 0; i--) {
      var p = pieces[i];
      p.x += p.vx; p.y += p.vy; p.vy += 0.03; p.rot += p.vr;
      ctx.save();
      ctx.translate(p.x, p.y);
      ctx.rotate(p.rot);
      ctx.fillStyle = p.color;
      ctx.fillRect(-p.r / 2, -p.r / 2, p.r, p.r * 0.6);
      ctx.restore();
      if (p.y > h + 40) pieces.splice(i, 1);
    }
    if (pieces.length > 0 || now < endAt) {
      raf = requestAnimationFrame(tick);
    } else {
      cancelAnimationFrame(raf); raf = null;
      ctx.clearRect(0, 0, canvas.width, canvas.height);
    }
  }

  function burst() {
    if (reduce) return;
    ensureCanvas();
    spawn(160);
    endAt = performance.now() + 1200;
    if (!raf) raf = requestAnimationFrame(tick);
  }

  var replay = document.currentScript.previousElementSibling;
  if (replay) replay.addEventListener('click', burst);
  if (reduce && replay) replay.style.display = 'none';

  if (document.readyState === 'complete') { setTimeout(burst, 250); }
  else { window.addEventListener('load', function () { setTimeout(burst, 250); }); }
})();
</script>
