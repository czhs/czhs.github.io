<style>
  /* /HCL-ML chrome, two pieces:
       1. .hcl-toc — left-margin scroll-spy contents (≥1280px).
       2. .hcl-ends — the end rail linking to the robotics portfolio.
     The document body ships encrypted; the contents rail is built from the
     DOM after unlock, so no section heading exists in the public layout. */

  /* ── contents rail ─────────────────────────────────────────── */
  .hcl-toc {
    position: fixed;
    top: 110px;
    left: max(14px, calc(50vw - 24rem - 300px));
    width: 250px;
    font-family: var(--rz-mono);
    font-size: 0.86rem;
    line-height: 1.55;
    display: none;
    z-index: 5;
  }
  @media (min-width: 1280px) {
    .hcl-toc.on {
      display: block;
    }
  }
  .hcl-toc p {
    margin: 0 0 8px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-size: 0.72rem;
    opacity: 0.55;
  }
  .hcl-toc a {
    display: block;
    padding: 3px 0 3px 12px;
    text-decoration: none;
    color: inherit;
    opacity: 0.6;
    border-left: 2px solid color-mix(in srgb, currentColor 22%, transparent);
  }
  .hcl-toc a.sub {
    padding-left: 26px;
    font-size: 0.78rem;
  }
  .hcl-toc a:hover {
    opacity: 1;
  }
  .hcl-toc a.now {
    opacity: 1;
    font-weight: 600;
    border-left: 2px solid currentColor;
  }

  /* ── end rail ──────────────────────────────────────────────── */
  .hcl-ends {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
    margin: 3rem 0 0;
    padding-top: 1.6rem;
    border-top: 2px solid color-mix(in srgb, var(--rz-text) 18%, transparent);
  }
  @media (max-width: 640px) {
    .hcl-ends {
      grid-template-columns: 1fr;
    }
  }
  .hcl-ends-lead {
    grid-column: 1 / -1;
    margin: 0;
    font-family: var(--rz-mono);
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--rz-text) 55%, transparent);
  }

  .hcl-end {
    display: block;
    padding: 0.9rem 1.05rem 1rem;
    font-family: var(--rz-sans);
    color: inherit;
    text-decoration: none;
    border: 2px solid color-mix(in srgb, var(--rz-text) 20%, transparent);
    border-radius: 10px;
    transition:
      border-color 0.15s ease,
      background 0.15s ease;
  }
  /* outrank the card's prose-link underline rule */
  .rzine-card a.hcl-end,
  .rzine-card a.hcl-end:hover {
    color: inherit;
    text-decoration: none;
    border-bottom-width: 2px;
  }
  .hcl-end:hover {
    border-color: var(--rz-text);
    background: color-mix(in srgb, var(--rz-text) 6%, transparent);
  }
  .hcl-end-k {
    display: block;
    font-family: var(--rz-mono);
    font-size: 0.66rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--rz-text) 55%, transparent);
  }
  .hcl-end-t {
    display: block;
    margin-top: 0.3rem;
    font-size: 1.22rem;
    font-weight: 700;
    line-height: 1.25;
  }
  .hcl-end-t::after {
    content: ' \2192';
    font-weight: 400;
  }
  .hcl-end-d {
    display: block;
    margin-top: 0.25rem;
    font-size: 0.9rem;
    line-height: 1.45;
    color: color-mix(in srgb, var(--rz-text) 72%, transparent);
  }
</style>
<script>
  window.__hclBind = function () {
    var toc = document.getElementById("hcl-toc");
    var article = document.querySelector("article.rzine-content");
    if (!toc || !article) return;

    var heads = [], links = {};

    function spy() {
      var line = window.innerHeight * 0.34;
      var current = heads[0];
      for (var i = 0; i < heads.length; i++) {
        if (heads[i].getBoundingClientRect().top <= line) current = heads[i];
        else break;
      }
      for (var id in links) links[id].classList.toggle("now", !!current && current.id === id);
    }

    function build() {
      heads = Array.prototype.slice.call(article.querySelectorAll("h2[id], h3[id]"));
      links = {};
      var html = "<p>contents</p>";
      heads.forEach(function (h) {
        html += '<a href="#' + h.id + '"' + (h.tagName === "H3" ? ' class="sub"' : "") + ">"
          + h.textContent + "</a>";
      });
      toc.innerHTML = html;
      Array.prototype.forEach.call(toc.querySelectorAll("a"), function (a) {
        links[a.getAttribute("href").slice(1)] = a;
      });
      toc.classList.toggle("on", heads.length > 0);
      spy();
    }

    toc.addEventListener("click", function (e) {
      var a = e.target.closest("a");
      if (!a) return;
      e.preventDefault();
      var t = document.getElementById(a.getAttribute("href").slice(1));
      if (t) t.scrollIntoView({ behavior: "smooth", block: "start" });
    });
    var ticking = false;
    window.addEventListener("scroll", function () {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(function () { spy(); ticking = false; });
      }
    }, { passive: true });

    // headings can change under the inline editor; let it ask for a redraw
    window.__hclRefresh = build;

    build();
  };
</script>
