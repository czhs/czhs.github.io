{%- comment -%}
  Warm rounded type, loaded only for the ringworld micro-site. Quicksand's
  geometric rounded terminals sit close to the artwork's hand lettering;
  Nunito carries the same warmth at paragraph length. The site-wide Roboto
  read cold beside the crayon drawing.
{%- endcomment -%}
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link
  rel="stylesheet"
  href="https://fonts.googleapis.com/css2?family=Nanum+Myeongjo:wght@400;700;800&family=Nunito:ital,wght@0,300..800;1,300..700&family=Quicksand:wght@400..700&display=swap" />

<style>
/* ── ringworld — standalone micro-site ────────────────────────
   Palette sampled from the ringworld artwork: cornflower ring blue and meadow
   olive on the drawing's own paper cream, with lavender + gold as sparkle
   accents. The page background is the illustration's background colour and
   carries the same dot grid, so the banner has no visible edge — the drawing
   sits on the page rather than being pasted onto it.

   Everything is scoped to body.rw-site. The --global-* rebinds are what the
   shared head.liquid / scripts.liquid components read, so they must be
   overridden here rather than in _themes.scss, which would repaint the rest
   of the site.
   ──────────────────────────────────────────────────────────── */

body.rw-site {
  /* palette */
  --rw-paper: #fef9f0;
  --rw-card: #fffdf7;
  --rw-ink: #24303f;
  --rw-ink-soft: #5a6b80;
  --rw-ring: #3e6fb4;
  --rw-meadow: #7c9a3c;
  --rw-lavender: #8b6fc4;
  --rw-gold: #d99b3c;
  --rw-line: rgba(36, 48, 63, 0.14);
  /* Cards need a heavier edge than the section rules do: the card fill is a
     near-match for the page cream, so at --rw-line the outline disappeared and
     the cards stopped reading as cards. */
  --rw-card-line: rgba(36, 48, 63, 0.24);
  --rw-dot: rgba(36, 48, 63, 0.07);

  /* rebind the theme vars shared components read */
  --global-bg-color: var(--rw-paper);
  --global-card-bg-color: var(--rw-card);
  --global-text-color: var(--rw-ink);
  --global-text-color-light: var(--rw-ink-soft);
  --global-theme-color: var(--rw-ring);
  --global-hover-color: var(--rw-lavender);
  --global-hover-text-color: #fff;
  --global-divider-color: var(--rw-line);
  --global-code-bg-color: rgba(62, 111, 180, 0.07);

  /* --rw-serif sets the two big headlines; --rw-display handles the smaller
     headings, where the serif's brush contrast gets muddy at size. */
  --rw-serif: "Nanum Myeongjo", Georgia, serif;
  --rw-display: "Quicksand", "Nunito", sans-serif;

  padding: 0;
  font-family: "Nunito", -apple-system, BlinkMacSystemFont, sans-serif;
  color: var(--rw-ink);
  background-color: var(--rw-paper);
  /* the illustration's dot paper, continued down the page */
  background-image: radial-gradient(var(--rw-dot) 1.4px, transparent 1.5px);
  background-size: 19px 19px;
  background-position: 0 0;
}

/* Light only. The artwork is drawn on cream and is the whole page's ground, so
   there is no honest night version of it — a dark ringworld would be a bright
   cream poster floating in a hole. al-folio's theme.js still stamps data-theme
   on <html> from the stored preference, so the light values are re-asserted for
   every value it can take rather than left to cascade. */
html[data-theme="dark"] body.rw-site,
html[data-theme="light"] body.rw-site,
html[data-theme-setting="dark"] body.rw-site {
  --rw-paper: #fef9f0;
  --rw-card: #fffdf7;
  --rw-ink: #24303f;
  --rw-ink-soft: #5a6b80;
  --rw-ring: #3e6fb4;
  --rw-meadow: #7c9a3c;
  --rw-lavender: #8b6fc4;
  --rw-gold: #d99b3c;
  --rw-line: rgba(36, 48, 63, 0.14);
  --rw-card-line: rgba(36, 48, 63, 0.24);
  --rw-dot: rgba(36, 48, 63, 0.07);
  --global-hover-text-color: #fff;
  --global-code-bg-color: rgba(62, 111, 180, 0.07);
}
html:has(body.rw-site) {
  color-scheme: light;
  background-color: #fef9f0;
}

/* shell: one centred column shared by masthead, content, footer. Matches MLn's
   940px so the two mastheads line up when you click between the sites. */
.rw-shell {
  width: 100%;
  max-width: 940px;
  margin: 0 auto;
  padding-left: 1.25rem;
  padding-right: 1.25rem;
}

/* ── masthead ─────────────────────────────────────────────── */
.rw-masthead {
  position: sticky;
  top: 0;
  z-index: 50;
  background: color-mix(in srgb, var(--rw-paper) 88%, transparent);
  border-bottom: 1px solid var(--rw-line);
  backdrop-filter: saturate(180%) blur(8px);
}
.rw-masthead-inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 1rem;
  height: 62px;
}
.rw-brand {
  display: inline-flex;
  align-items: center;
  gap: 0.55rem;
  text-decoration: none;
  color: var(--rw-ink);
  min-width: 0;
}
.rw-brand:hover { text-decoration: none; }
.rw-brand-ring {
  width: 52px;
  height: auto;
  flex: 0 0 auto;
}
/* The wordmark is the artwork's own hand lettering rather than type: it is
   loaded as an alpha mask over currentColor so it inverts with the theme. */
.rw-brand-mark {
  display: block;
  width: 104px;
  height: 26px;
  background: currentColor;
  -webkit-mask: url("{{ '/assets/img/ringworld/wordmark.png' | relative_url }}") left center / contain no-repeat;
  mask: url("{{ '/assets/img/ringworld/wordmark.png' | relative_url }}") left center / contain no-repeat;
}
.rw-topnav {
  display: flex;
  align-items: center;
  gap: 1.1rem;
}
.rw-topnav a {
  font-size: 0.88rem;
  font-weight: 500;
  color: var(--rw-ink);
  text-decoration: none;
  opacity: 0.75;
  white-space: nowrap;
  transition: opacity 0.15s ease, color 0.15s ease;
}
.rw-topnav a:hover { opacity: 1; color: var(--rw-ring); text-decoration: none; }

/* the sibling club: carries MLn's own dot-ring mark and sits as a pill, so the
   link between the two micro-sites reads as a place to go rather than a word */
.rw-sibling {
  display: inline-flex;
  align-items: center;
  justify-content: flex-start;
  gap: 0.45rem;
  /* Fixed width, and last in the nav, so the pill's right edge is pinned by the
     shell and its left edge — where the mark sits — is identical on both sites.
     Keep in sync with .mln-sibling. */
  min-width: 132px;
  height: 32px;
  padding: 0 0.72rem 0 0.6rem;
  border: 1px solid var(--rw-card-line);
  border-radius: 999px;
  font-weight: 600;
  opacity: 1;
}
.rw-sibling:hover {
  border-color: var(--rw-ring);
  background: var(--rw-card);
}
.rw-sibling-ico {
  /* fixed 24px slot, mark centred in it — the icons have different aspect
     ratios, so the slot is what actually aligns */
  display: block;
  width: 24px;
  height: 16px;
  flex: 0 0 auto;
  background: currentColor;
  -webkit-mask: url("{{ '/assets/img/mln_mark.png' | relative_url }}") center / contain no-repeat;
  mask: url("{{ '/assets/img/mln_mark.png' | relative_url }}") center / contain no-repeat;
}

.rw-main { padding-bottom: 3.5rem; min-height: 60vh; }

/* ── banner ───────────────────────────────────────────────── */
/* The artwork's own background is --rw-paper, so no border or radius: the
   bottom edge is masked into the page and the dot grid carries on beneath. */
.rw-banner {
  margin: 0 auto;
  max-width: 940px;
  line-height: 0;
}
.rw-banner img {
  display: block;
  width: 100%;
  height: auto;
  /* Only the last sliver fades — the mask exists to hide the phase mismatch
     between the drawing's dot grid and the page's, not to vignette the art.
     Fading from 78% swallowed the wordmark. */
  -webkit-mask-image: linear-gradient(to bottom, #000 95%, transparent 100%);
  mask-image: linear-gradient(to bottom, #000 95%, transparent 100%);
}

/* ── hero ─────────────────────────────────────────────────── */
.rw-hero { margin: 0 0 1.6rem; }

/* ── sprites ──────────────────────────────────────────────── */
/* Characters from assets/img/ringworld/sprites/. Each session picks one via
   `sprite:` in _data/ringworld.yml, and a blog post can pick one via `sprite:`
   in its front matter as a stand-in for a cover. Always decoration, so every
   one is aria-hidden with an empty alt and takes no pointer events. */
.rw-tile-art img,
.rw-post-thumb-sprite,
.rw-empty-art,
.rw-detail-sprite { pointer-events: none; user-select: none; }

.rw-detail-sprite {
  position: absolute;
  top: -10px;
  right: 0;
  width: 84px;
}
@media (max-width: 560px) {
  .rw-detail-sprite { width: 60px; top: -6px; }
}
/* Type stays quiet on purpose. The hand-drawn banner and wordmark carry the
   personality; a display face competing with them made the page feel busy. */
.rw-hero-title {
  font-family: var(--rw-serif);
  font-weight: 400;
  font-size: clamp(1.4rem, 3.3vw, 1.95rem);
  line-height: 1.3;
  letter-spacing: 0;
  margin: 0 0 0.8rem;
  max-width: none;
}
/* one line once there is room for it; below that it wraps rather than overflow */
@media (min-width: 900px) {
  .rw-hero-title { white-space: nowrap; }
}
.rw-hero-title em {
  font-style: normal;
  font-weight: 700;
  color: var(--rw-ring);
}
.rw-hero-lead {
  font-size: 0.97rem;
  line-height: 1.62;
  color: var(--rw-ink);
  opacity: 0.88;
  max-width: 64ch;
  margin: 0 0 1rem;
}

/* One row instead of stacked full-width bands. The toggle is in normal flow at
   the left; the chips are pinned to the top-right and out of it. That is what
   keeps the summary still when the panel opens — in a flex row the toggle got
   pushed to another line, so the spot that opened the panel was not the spot
   that closed it. */
.rw-metarow {
  position: relative;
  margin: 0 0 1.7rem;
  padding-bottom: 0.55rem;
  border-bottom: 1px solid var(--rw-line);
  font-family: var(--global-code-font-family, monospace);
  font-size: 0.79rem;
}
.rw-metachips {
  position: absolute;
  top: 0;
  right: 0;
  display: flex;
  gap: 0.5rem;
}
@media (max-width: 760px) {
  .rw-metachips {
    position: static;
    flex-wrap: wrap;
    margin-top: 0.65rem;
  }
}
.rw-chip {
  display: inline-flex;
  align-items: center;
  min-height: 28px;
  padding: 0.2rem 0.7rem;
  border: 1px solid var(--rw-line);
  border-radius: 999px;
  background: var(--rw-card);
  opacity: 0.9;
}
.rw-metarow a {
  color: var(--rw-ring);
  text-decoration: none;
  font-weight: 600;
}
.rw-metarow a:hover { text-decoration: underline; }

/* ── "What's this?" ───────────────────────────────────────── */
.rw-faq {
  margin: 0;
  border: none;
}
/* Styled as a pill so it reads as something you press — as bare text with a
   chevron, people didn't see there was anything to open. */
.rw-faq summary {
  cursor: pointer;
  list-style: none;
  display: inline-flex;
  align-items: center;
  gap: 0.4rem;
  /* matches the chip height so the toggle and the chips share one band */
  min-height: 28px;
  padding: 0.2rem 0.85rem 0.2rem 0.7rem;
  border: 1px solid var(--rw-card-line);
  border-radius: 999px;
  background: var(--rw-card);
  font-family: var(--rw-display);
  font-weight: 600;
  font-size: 0.84rem;
  transition: border-color 0.15s ease, color 0.15s ease;
}
.rw-faq summary:hover,
.rw-faq[open] summary {
  border-color: var(--rw-ring);
  color: var(--rw-ring);
}
.rw-faq summary::-webkit-details-marker { display: none; }
.rw-faq summary::before {
  content: "›";
  display: inline-block;
  font-size: 1.15rem;
  line-height: 1;
  color: var(--rw-ring);
  transition: transform 0.15s ease;
}
.rw-faq[open] summary::before { transform: rotate(90deg); }

.rw-about {
  columns: 3 230px;
  column-gap: 2.1rem;
  margin: 0;
  padding: 1.25rem 0 1.2rem;
}
.rw-about-sec {
  break-inside: avoid;
  -webkit-column-break-inside: avoid;
  margin: 0 0 1.35rem;
}
.rw-about-h {
  margin: 0 0 0.4rem;
  font-size: 0.71rem;
  font-weight: 700;
  letter-spacing: 0.07em;
  text-transform: uppercase;
  color: var(--rw-ring);
  font-family: var(--global-code-font-family, monospace);
}
.rw-about-sec p { margin: 0 0 0.5rem; }
.rw-about-sec p:last-child { margin-bottom: 0; }
.rw-about-sec ul { margin: 0; padding-left: 1.05rem; }
.rw-about-sec li,
.rw-about-sec p { font-size: 0.885rem; line-height: 1.55; opacity: 0.9; }
.rw-about-sec li { margin-bottom: 0.35rem; }
.rw-about-sec li:last-child { margin-bottom: 0; }
.rw-sched {
  margin: 0;
  font-family: var(--global-code-font-family, monospace);
  font-size: 0.82rem;
}
.rw-sched > div { display: flex; gap: 0.55rem; padding: 0.13rem 0; }
.rw-sched dt { flex: 0 0 4.9rem; font-weight: 700; opacity: 0.9; }
.rw-sched dd { margin: 0; opacity: 0.82; }
@media (max-width: 576px) { .rw-about { columns: 1; } }

/* ── section headers ──────────────────────────────────────── */
.rw-sec { margin: 0 0 2.4rem; }
.rw-sec-head {
  display: flex;
  align-items: baseline;
  gap: 0.75rem;
  padding-bottom: 0.55rem;
  margin-bottom: 1.1rem;
  border-bottom: 1px solid var(--rw-line);
}
.rw-sec-title {
  font-family: var(--rw-display);
  font-weight: 600;
  font-size: 1.15rem;
  margin: 0;
}
.rw-sec-note {
  font-family: var(--global-code-font-family, monospace);
  font-size: 0.74rem;
  opacity: 0.6;
}
.rw-sec-link {
  margin-left: auto;
  font-family: var(--global-code-font-family, monospace);
  font-size: 0.78rem;
  font-weight: 600;
  color: var(--rw-ring);
  text-decoration: none;
  white-space: nowrap;
}
.rw-sec-link:hover { text-decoration: underline; }

/* ── blog feed — the main element ─────────────────────────── */
.rw-feed {
  list-style: none;
  padding: 0;
  margin: 0;
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(272px, 1fr));
  gap: 1rem;
}
.rw-feed li { margin: 0; }

.rw-post-card {
  display: flex;
  flex-direction: column;
  height: 100%;
  border: 1px solid var(--rw-card-line);
  border-radius: 14px;
  background: var(--rw-card);
  color: inherit;
  text-decoration: none;
  overflow: hidden;
  transition: border-color 0.15s ease, transform 0.15s ease, box-shadow 0.15s ease;
}
.rw-post-card:hover {
  border-color: var(--rw-ring);
  text-decoration: none;
  transform: translateY(-2px);
  box-shadow: 0 8px 22px rgba(36, 48, 63, 0.09);
}
.rw-post-thumb {
  aspect-ratio: 16 / 10;
  overflow: hidden;
  background: var(--global-code-bg-color);
}
.rw-post-thumb img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
  transition: transform 0.25s ease;
}
.rw-post-card:hover .rw-post-thumb img { transform: scale(1.03); }
/* no cover: the post's character on a tinted field, so the feed has no holes */
.rw-post-thumb.is-sprite {
  display: flex;
  align-items: center;
  justify-content: center;
}
.rw-post-thumb-sprite {
  width: auto;
  height: auto;
  max-width: 46%;
  max-height: 68%;
  object-fit: contain;
}
.rw-post-card:hover .rw-post-thumb-sprite { transform: translateY(-3px) rotate(-3deg); }

.rw-post-body {
  display: flex;
  flex-direction: column;
  flex: 1;
  padding: 0.9rem 1.05rem 1rem;
}
.rw-post-title {
  font-family: var(--rw-display);
  font-weight: 600;
  font-size: 1.06rem;
  line-height: 1.3;
  margin: 0 0 0.3rem;
}
.rw-post-meta {
  font-family: var(--global-code-font-family, monospace);
  font-size: 0.72rem;
  opacity: 0.65;
  margin: 0 0 0.55rem;
}
.rw-post-excerpt {
  font-size: 0.87rem;
  line-height: 1.52;
  opacity: 0.85;
  margin: 0 0 0.85rem;
}
.rw-post-cta { margin-top: auto; }
.rw-post-card:hover .rw-post-cta .rw-arrow { transform: translateX(3px); }

/* empty feed: an invitation, not a blank */
.rw-empty {
  display: flex;
  align-items: center;
  gap: 1.2rem;
  padding: 1.4rem 1.5rem;
  border: 1px dashed var(--rw-card-line);
  border-radius: 14px;
}
.rw-empty-art { width: 74px; height: auto; flex: 0 0 auto; }
.rw-empty-lead {
  font-family: var(--rw-display);
  font-weight: 600;
  font-size: 1rem;
  margin: 0 0 0.35rem;
}
.rw-empty-note {
  font-size: 0.89rem;
  line-height: 1.55;
  opacity: 0.82;
  margin: 0;
  max-width: 56ch;
}
@media (max-width: 520px) {
  .rw-empty { flex-direction: column; align-items: flex-start; gap: 0.8rem; }
}

/* ── sessions row ─────────────────────────────────────────── */
/* Small cards, not a grid: the blog is the page, and the sessions are the
   invitation beneath it. The row scrolls sideways rather than wrapping, so a
   long history never pushes the blog up off the screen. Cards link straight to
   Luma — that is where you register, and a detail page in between only added a
   click. No cover image: every session is the same recurring event, so each one
   picks a character via `sprite:` instead. */
.rw-strip {
  list-style: none;
  /* The scroll container clips whatever leaves its box, so the padding has to
     be at least as large as the shadow it must contain — otherwise the blur
     gets sliced and reads as a hard edge. The widest shadow here is
     `0 10px 24px` on hover, so it reaches 14px above, 34px below, 24px to each
     side; the lift adds another 2px on top. Negative margins cancel the extra
     space so the row still lines up with the rule above it. Side allowance is
     kept under the shell's 20px padding so nothing overflows the page. */
  margin: -16px -18px -30px;
  padding: 16px 18px 36px;
  display: flex;
  gap: 0.75rem;
  overflow-x: auto;
  scrollbar-width: thin;
  -webkit-overflow-scrolling: touch;
}
.rw-strip li { margin: 0; flex: 0 0 auto; }

/* The tile is a layout box only — the card chrome lives on .rw-tile-face, so a
   photo card can put a second face on the back without duplicating any of it.
   The lift stays on the tile and the rotation on the flip, so the two
   transforms compose instead of fighting. */
.rw-tile {
  display: block;
  width: 138px;
  color: inherit;
  text-decoration: none;
  perspective: 850px;
  transition: transform 0.15s ease;
}
.rw-tile:hover { text-decoration: none; transform: translateY(-2px); }

.rw-tile-flip {
  position: relative;
  display: block;
  transform-style: preserve-3d;
  transition: transform 0.55s cubic-bezier(0.2, 0.7, 0.3, 1);
}
.rw-tile-face {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 0.8rem 0.7rem 0.85rem;
  border: 1px solid var(--rw-card-line);
  border-radius: 14px;
  background: var(--rw-card);
  backface-visibility: hidden;
  -webkit-backface-visibility: hidden;
  overflow: hidden;
  transition: border-color 0.15s ease, box-shadow 0.15s ease;
}
.rw-tile:hover .rw-tile-face {
  border-color: var(--rw-ring);
  box-shadow: 0 8px 20px rgba(36, 48, 63, 0.09);
}
/* the front is in flow and sets the card's height; the back sits on top of it */
.rw-tile-back {
  position: absolute;
  inset: 0;
  padding: 0;
  transform: rotateY(180deg);
}
.rw-tile.has-photo:hover .rw-tile-flip,
.rw-tile.has-photo:focus-visible .rw-tile-flip { transform: rotateY(180deg); }

.rw-tile-photo {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}
.rw-tile-back-label {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 0.9rem 0.6rem 0.45rem;
  font-family: var(--global-code-font-family, monospace);
  font-size: 0.66rem;
  font-weight: 700;
  letter-spacing: 0.05em;
  text-transform: uppercase;
  text-align: center;
  color: #fff;
  background: linear-gradient(to top, rgba(20, 28, 40, 0.72), transparent);
}
/* The flip affordance is stated once on the section header, since it applies to
   the whole row, and hover doesn't exist on touch, so that half is hidden there
   while the click half stays. */
@media (hover: none) {
  .rw-sec-note .is-hover-only { display: none; }
}
.rw-tile-art {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 74px;
  margin-bottom: 0.55rem;
}
.rw-tile-art img {
  max-width: 104px;
  max-height: 74px;
  width: auto;
  height: auto;
  transition: transform 0.25s ease, opacity 0.15s ease;
}
.rw-tile:hover .rw-tile-art img { transform: translateY(-3px) rotate(-3deg) scale(1.03); }
.rw-tile-num {
  font-family: var(--global-code-font-family, monospace);
  font-size: 0.68rem;
  font-weight: 700;
  letter-spacing: 0.05em;
  text-transform: uppercase;
  color: var(--rw-ring);
}
.rw-tile-date {
  font-family: var(--global-code-font-family, monospace);
  font-size: 0.71rem;
  opacity: 0.6;
  margin-top: 0.12rem;
}
.rw-tile-flag {
  margin-top: 0.45rem;
  font-family: var(--global-code-font-family, monospace);
  font-size: 0.62rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.06em;
  padding: 0.12rem 0.45rem;
  border-radius: 999px;
  color: var(--global-hover-text-color);
  background: var(--rw-ring);
}
/* the ring is drawn inset rather than outset: an outer 0 0 0 1px doubled up
   against the 1px border and was the first thing the scroll box clipped */
.rw-tile.is-next .rw-tile-front {
  border-color: var(--rw-ring);
  box-shadow: inset 0 0 0 1px var(--rw-ring), 0 6px 18px rgba(62, 111, 180, 0.14);
}
.rw-tile.is-next:hover .rw-tile-front {
