{%- comment -%}
  Warm rounded type, loaded only for the ringworld micro-site. Quicksand's
  geometric rounded terminals sit close to the artwork's hand lettering;
  Nunito carries the same warmth at paragraph length. The site-wide Roboto
  read cold beside the crayon drawing.
{%- endcomment -%}
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link
  rel="stylesheet"
  href="https://fonts.googleapis.com/css2?family=Nanum+Myeongjo:wght@400;700;800&family=Nunito:ital,wght@0,300..800;1,300..700&family=Quicksand:wght@400..700&display=swap" />

<style>
/* ── ringworld — standalone micro-site ────────────────────────
   Palette sampled from the ringworld artwork: cornflower ring blue and meadow
   olive on the drawing's own paper cream, with lavender + gold as sparkle
   accents. The page background is the illustration's background colour and
   carries the same dot grid, so the banner has no visible edge — the drawing
   sits on the page rather than being pasted onto it.

   Everything is scoped to body.rw-site. The --global-* rebinds are what the
   shared head.liquid / scripts.liquid components read, so they must be
   overridden here rather than in _themes.scss, which would repaint the rest
   of the site.
   ──────────────────────────────────────────────────────────── */

body.rw-site {
  /* palette */
  --rw-paper: #fef9f0;
  --rw-card: #fffdf7;
  --rw-ink: #24303f;
  --rw-ink-soft: #5a6b80;
  --rw-ring: #3e6fb4;
  --rw-meadow: #7c9a3c;
  --rw-lavender: #8b6fc4;
  --rw-gold: #d99b3c;
  --rw-line: rgba(36, 48, 63, 0.14);
  --rw-dot: rgba(36, 48, 63, 0.07);

  /* rebind the theme vars shared components read */
  --global-bg-color: var(--rw-paper);
  --global-card-bg-color: var(--rw-card);
  --global-text-color: var(--rw-ink);
  --global-text-color-light: var(--rw-ink-soft);
  --global-theme-color: var(--rw-ring);
  --global-hover-color: var(--rw-lavender);
  --global-hover-text-color: #fff;
  --global-divider-color: var(--rw-line);
  --global-code-bg-color: rgba(62, 111, 180, 0.07);

  /* --rw-serif sets the two big headlines; --rw-display handles the smaller
     headings, where the serif's brush contrast gets muddy at size. */
  --rw-serif: "Nanum Myeongjo", Georgia, serif;
  --rw-display: "Quicksand", "Nunito", sans-serif;

  padding: 0;
  font-family: "Nunito", -apple-system, BlinkMacSystemFont, sans-serif;
  color: var(--rw-ink);
  background-color: var(--rw-paper);
  /* the illustration's dot paper, continued down the page */
  background-image: radial-gradient(var(--rw-dot) 1.4px, transparent 1.5px);
  background-size: 19px 19px;
  background-position: 0 0;
}

/* Light only. The artwork is drawn on cream and is the whole page's ground, so
   there is no honest night version of it — a dark ringworld would be a bright
   cream poster floating in a hole. al-folio's theme.js still stamps data-theme
   on <html> from the stored preference, so the light values are re-asserted for
   every value it can take rather than left to cascade. */
html[data-theme="dark"] body.rw-site,
html[data-theme="light"] body.rw-site,
html[data-theme-setting="dark"] body.rw-site {
  --rw-paper: #fef9f0;
  --rw-card: #fffdf7;
  --rw-ink: #24303f;
  --rw-ink-soft: #5a6b80;
  --rw-ring: #3e6fb4;
  --rw-meadow: #7c9a3c;
  --rw-lavender: #8b6fc4;
  --rw-gold: #d99b3c;
  --rw-line: rgba(36, 48, 63, 0.14);
  --rw-dot: rgba(36, 48, 63, 0.07);
  --global-hover-text-color: #fff;
  --global-code-bg-color: rgba(62, 111, 180, 0.07);
}
html:has(body.rw-site) {
  color-scheme: light;
  background-color: #fef9f0;
}

/* shell: one centred column shared by masthead, content, footer */
.rw-shell {
  width: 100%;
  max-width: 1020px;
  margin: 0 auto;
  padding-left: 1.25rem;
  padding-right: 1.25rem;
}

/* ── masthead ─────────────────────────────────────────────── */
.rw-masthead {
  position: sticky;
  top: 0;
  z-index: 50;
  background: color-mix(in srgb, var(--rw-paper) 88%, transparent);
  border-bottom: 1px solid var(--rw-line);
  backdrop-filter: saturate(180%) blur(8px);
}
.rw-masthead-inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 1rem;
  height: 62px;
}
.rw-brand {
  display: inline-flex;
  align-items: center;
  gap: 0.55rem;
  text-decoration: none;
  color: var(--rw-ink);
  min-width: 0;
}
.rw-brand:hover { text-decoration: none; }
.rw-brand-ring {
  width: 52px;
  height: auto;
  flex: 0 0 auto;
}
/* The wordmark is the artwork's own hand lettering rather than type: it is
   loaded as an alpha mask over currentColor so it inverts with the theme. */
.rw-brand-mark {
  display: block;
  width: 104px;
  height: 26px;
  background: currentColor;
  -webkit-mask: url("{{ '/assets/img/ringworld/wordmark.png' | relative_url }}") left center / contain no-repeat;
  mask: url("{{ '/assets/img/ringworld/wordmark.png' | relative_url }}") left center / contain no-repeat;
}
.rw-topnav {
  display: flex;
  align-items: center;
  gap: 1.1rem;
}
.rw-topnav a {
  font-size: 0.88rem;
  font-weight: 500;
  color: var(--rw-ink);
  text-decoration: none;
  opacity: 0.75;
  white-space: nowrap;
  transition: opacity 0.15s ease, color 0.15s ease;
}
.rw-topnav a:hover { opacity: 1; color: var(--rw-ring); text-decoration: none; }

.rw-main { padding-bottom: 3.5rem; min-height: 60vh; }

/* ── banner ───────────────────────────────────────────────── */
/* The artwork's own background is --rw-paper, so no border or radius: the
   bottom edge is masked into the page and the dot grid carries on beneath. */
.rw-banner {
  margin: 0 auto;
  max-width: 1020px;
  line-height: 0;
}
.rw-banner img {
  display: block;
  width: 100%;
  height: auto;
  -webkit-mask-image: linear-gradient(to bottom, #000 78%, transparent 100%);
  mask-image: linear-gradient(to bottom, #000 78%, transparent 100%);
}

/* ── hero ─────────────────────────────────────────────────── */
.rw-hero { margin: 0 0 1.6rem; }
/* Type stays quiet on purpose. The hand-drawn banner and wordmark carry the
   personality; a display face competing with them made the page feel busy. */
.rw-hero-title {
  font-family: var(--rw-serif);
  font-weight: 400;
  font-size: 1.95rem;
  line-height: 1.34;
  letter-spacing: 0;
  margin: 0 0 0.8rem;
  /* wide enough to sit on two lines — at 20ch it stacked three deep and read
     as a column rather than a sentence */
  max-width: 30ch;
}
.rw-hero-title em {
  font-style: normal;
  font-weight: 700;
  color: var(--rw-ring);
}
.rw-hero-lead {
  font-size: 0.97rem;
  line-height: 1.62;
  color: var(--rw-ink);
  opacity: 0.88;
  max-width: 64ch;
  margin: 0 0 1rem;
}

.rw-cadence {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 0.5rem;
  margin: 0 0 1.15rem;
  font-family: var(--global-code-font-family, monospace);
  font-size: 0.79rem;
}
.rw-chip {
  padding: 0.24rem 0.68rem;
  border: 1px solid var(--rw-line);
  border-radius: 999px;
  background: var(--rw-card);
  opacity: 0.9;
}
.rw-cadence a {
  color: var(--rw-ring);
  text-decoration: none;
  font-weight: 600;
}
.rw-cadence a:hover { text-decoration: underline; }

/* ── "What's this?" ───────────────────────────────────────── */
.rw-faq {
  margin: 0 0 1.6rem;
  border-top: 1px solid var(--rw-line);
  border-bottom: 1px solid var(--rw-line);
}
.rw-faq summary {
  cursor: pointer;
  list-style: none;
  display: flex;
  align-items: center;
  gap: 0.5rem;
  padding: 0.65rem 0;
  font-family: var(--rw-display);
  font-weight: 600;
  font-size: 0.96rem;
}
.rw-faq summary::-webkit-details-marker { display: none; }
.rw-faq summary::before {
  content: "›";
  display: inline-block;
  font-size: 1.15rem;
  line-height: 1;
  color: var(--rw-ring);
  transition: transform 0.15s ease;
}
.rw-faq[open] summary::before { transform: rotate(90deg); }
.rw-faq[open] summary { padding-bottom: 0.3rem; }

.rw-about {
  columns: 3 230px;
  column-gap: 2.1rem;
  margin: 0;
  padding-bottom: 1.2rem;
}
.rw-about-sec {
  break-inside: avoid;
  -webkit-column-break-inside: avoid;
  margin: 0 0 1.35rem;
}
.rw-about-h {
  margin: 0 0 0.4rem;
  font-size: 0.71rem;
  font-weight: 700;
  letter-spacing: 0.07em;
  text-transform: uppercase;
  color: var(--rw-ring);
  font-family: var(--global-code-font-family, monospace);
}
.rw-about-sec p { margin: 0 0 0.5rem; }
.rw-about-sec p:last-child { margin-bottom: 0; }
.rw-about-sec ul { margin: 0; padding-left: 1.05rem; }
.rw-about-sec li,
.rw-about-sec p { font-size: 0.885rem; line-height: 1.55; opacity: 0.9; }
.rw-about-sec li { margin-bottom: 0.35rem; }
.rw-about-sec li:last-child { margin-bottom: 0; }
.rw-sched {
  margin: 0;
  font-family: var(--global-code-font-family, monospace);
  font-size: 0.82rem;
}
.rw-sched > div { display: flex; gap: 0.55rem; padding: 0.13rem 0; }
.rw-sched dt { flex: 0 0 4.9rem; font-weight: 700; opacity: 0.9; }
.rw-sched dd { margin: 0; opacity: 0.82; }
@media (max-width: 576px) { .rw-about { columns: 1; } }

/* ── session grid ─────────────────────────────────────────── */
/* No cover thumbnails: every session is the same recurring event, so a row of
   identical Luma covers would carry no information. The session number and
   date do the work instead, over a faint ring watermark. */
.rw-grid {
  list-style: none;
  padding: 0;
  margin: 0;
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(275px, 1fr));
  gap: 0.9rem;
}
.rw-grid li { margin: 0; }

.rw-card {
  position: relative;
  display: flex;
  flex-direction: column;
  height: 100%;
  min-height: 172px;
  padding: 1rem 1.15rem 1.1rem;
  border: 1px solid var(--rw-line);
  border-radius: 14px;
  background: var(--rw-card);
  color: inherit;
  text-decoration: none;
  overflow: hidden;
  isolation: isolate;
  transition: border-color 0.15s ease, transform 0.15s ease, box-shadow 0.15s ease;
}
.rw-card:hover {
  border-color: var(--rw-ring);
  text-decoration: none;
  transform: translateY(-2px);
  box-shadow: 0 8px 22px rgba(36, 48, 63, 0.09);
}

/* the ring: a faint outline arc bleeding off the card's lower-right corner */
.rw-card-ring {
  position: absolute;
  right: -46px;
  bottom: -58px;
  width: 168px;
  height: 168px;
  border: 9px solid var(--rw-ring);
  border-radius: 50%;
  opacity: 0.09;
  z-index: 0;
  transition: transform 0.35s ease, opacity 0.2s ease;
}
/* keep the card's text above the watermark without letting it escape the
   card's rounded clip — z-index:-1 punched it through the card background */
.rw-card > *:not(.rw-card-ring) { position: relative; z-index: 1; }
.rw-card:hover .rw-card-ring { transform: rotate(18deg) scale(1.06); opacity: 0.15; }

.rw-card-top {
  display: flex;
  align-items: baseline;
  gap: 0.5rem;
  margin-bottom: 0.55rem;
}
.rw-num {
  font-family: var(--global-code-font-family, monospace);
  font-size: 0.72rem;
  font-weight: 700;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--rw-ring);
}
.rw-date {
  margin-left: auto;
  font-family: var(--global-code-font-family, monospace);
  font-size: 0.72rem;
  opacity: 0.6;
}
.rw-card-title {
  font-family: var(--rw-display);
  font-weight: 600;
  margin: 0 0 0.4rem;
  font-size: 1.1rem;
  line-height: 1.28;
}
.rw-card-blurb {
  margin: 0 0 0.85rem;
  font-size: 0.865rem;
  line-height: 1.52;
  opacity: 0.85;
}
.rw-card-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 0.35rem;
  margin: 0 0 0.8rem;
}
.rw-tag {
  display: inline-flex;
  align-items: center;
  gap: 0.28rem;
  font-family: var(--global-code-font-family, monospace);
  font-size: 0.67rem;
  font-weight: 600;
  padding: 0.14rem 0.5rem;
  border-radius: 999px;
  border: 1px solid var(--rw-line);
  background: var(--global-code-bg-color);
  opacity: 0.9;
}
.rw-tag-ico { font-size: 0.72rem; line-height: 1; }
.rw-card-cta {
  margin-top: auto;
  font-family: var(--global-code-font-family, monospace);
  font-size: 0.77rem;
  font-weight: 600;
  color: var(--rw-ring);
  display: inline-flex;
  align-items: center;
  gap: 0.35rem;
}
.rw-arrow { transition: transform 0.15s ease; display: inline-block; }
.rw-card:hover .rw-card-cta .rw-arrow { transform: translateX(3px); }

.rw-status {
  font-family: var(--global-code-font-family, monospace);
  font-size: 0.64rem;
  text-transform: uppercase;
  letter-spacing: 0.07em;
  padding: 0.14rem 0.5rem;
  border-radius: 999px;
  border: 1px solid var(--rw-line);
  opacity: 0.7;
}
.rw-status.is-upcoming {
  color: var(--global-hover-text-color);
  background: var(--rw-ring);
  border-color: var(--rw-ring);
  opacity: 1;
}

/* the next session */
.rw-card.is-next {
  border-color: var(--rw-ring);
  box-shadow: 0 0 0 1px var(--rw-ring), 0 8px 24px rgba(62, 111, 180, 0.14);
}
.rw-card.is-next:hover {
  box-shadow: 0 0 0 1px var(--rw-ring), 0 12px 28px rgba(62, 111, 180, 0.2);
}
.rw-card.is-next .rw-card-ring { opacity: 0.16; }
.rw-flag {
  font-family: var(--global-code-font-family, monospace);
  font-size: 0.64rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.07em;
  padding: 0.14rem 0.5rem;
  border-radius: 999px;
  color: var(--global-hover-text-color);
  background: var(--rw-ring);
}
.rw-soon-flag {
  color: var(--rw-ink);
  background: transparent;
  border: 1px dashed var(--rw-line);
}

/* "+N more upcoming" toggle card */
.rw-more-card {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  justify-content: center;
  gap: 0.35rem;
  width: 100%;
  height: 100%;
  min-height: 172px;
  padding: 1rem 1.15rem;
  border: 1px dashed var(--rw-line);
  border-radius: 14px;
  background: transparent;
  color: inherit;
  cursor: pointer;
  font: inherit;
  text-align: left;
  transition: border-color 0.15s ease, background 0.15s ease;
}
.rw-more-card:hover { border-color: var(--rw-ring); background: var(--rw-card); }
.rw-more-icon {
  font-family: var(--global-code-font-family, monospace);
  font-size: 1.85rem;
  font-weight: 700;
  line-height: 1;
  color: var(--rw-ring);
}
.rw-more-label {
  font-family: var(--global-code-font-family, monospace);
  font-size: 0.78rem;
  font-weight: 600;
  align-items: center;
  gap: 0.35rem;
  opacity: 0.8;
}
.rw-more-open { display: inline-flex; }
.rw-more-close { display: none; }
.rw-far-session { display: none; }
.rw-grid.rw-expanded .rw-far-session { display: block; }
.rw-grid.rw-expanded .rw-more-open { display: none; }
.rw-grid.rw-expanded .rw-more-close { display: inline-flex; }

/* ── detail page ──────────────────────────────────────────── */
.rw-back {
  display: inline-flex;
  align-items: center;
  gap: 0.35rem;
  font-family: var(--global-code-font-family, monospace);
  font-size: 0.79rem;
  color: var(--rw-ink);
  opacity: 0.72;
  text-decoration: none;
  margin-bottom: 1.25rem;
}
.rw-back:hover { opacity: 1; color: var(--rw-ring); text-decoration: none; }

.rw-detail-head { margin-bottom: 1.6rem; }
.rw-detail-eyebrow {
  font-family: var(--global-code-font-family, monospace);
  font-size: 0.75rem;
  font-weight: 700;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--rw-ring);
  margin-bottom: 0.3rem;
}
.rw-detail-title {
  font-family: var(--rw-serif);
  font-weight: 400;
  font-size: 1.85rem;
  line-height: 1.3;
  margin: 0;
}
.rw-detail-when {
  margin: 0.5rem 0 0;
  font-family: var(--global-code-font-family, monospace);
  font-size: 0.82rem;
  opacity: 0.7;
}

.rw-detail-grid {
  display: grid;
  grid-template-columns: minmax(0, 1fr);
  gap: 2rem;
  align-items: start;
}
@media (min-width: 800px) {
  .rw-detail-grid { grid-template-columns: minmax(0, 1.45fr) 340px; }
}

.rw-body h2 {
  font-family: var(--rw-display);
  font-weight: 600;
  font-size: 1.18rem;
  margin: 1.9rem 0 0.6rem;
}
.rw-body h2:first-child { margin-top: 0; }
.rw-desc { font-size: 0.95rem; line-height: 1.68; }
.rw-desc p { margin: 0 0 0.9em; opacity: 0.9; }
.rw-desc p:last-child { margin-bottom: 0; }
.rw-desc strong { font-weight: 600; color: var(--rw-ring); }

.rw-embed { position: sticky; top: 5.4rem; }
.rw-embed iframe {
  width: 100%;
  height: 540px;
  border: 1px solid var(--rw-line);
  border-radius: 14px;
  background: var(--rw-card);
}
.rw-embed-fallback {
  margin: 0.6rem 0 0;
  font-size: 0.78rem;
  text-align: center;
  opacity: 0.72;
}
.rw-embed-fallback a { color: var(--rw-ring); }

/* ── footer ───────────────────────────────────────────────── */
.rw-foot {
  border-top: 1px solid var(--rw-line);
  padding: 1.5rem 0;
  margin-top: 2rem;
}
.rw-foot-inner {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 0.5rem;
  font-size: 0.81rem;
  opacity: 0.75;
}
.rw-foot-name { font-weight: 600; opacity: 1; }
.rw-foot-dot { opacity: 0.5; }
.rw-foot-by { margin-left: auto; color: var(--rw-ring); text-decoration: none; }
.rw-foot-by:hover { text-decoration: underline; }

/* ── quality floor ────────────────────────────────────────── */
.rw-card:focus-visible,
.rw-more-card:focus-visible,
.rw-topnav a:focus-visible,
.rw-brand:focus-visible {
  outline: 2px solid var(--rw-ring);
  outline-offset: 3px;
}
@media (prefers-reduced-motion: reduce) {
  .rw-card,
  .rw-card-ring,
  .rw-arrow,
  .rw-more-card { transition: none; }
  .rw-card:hover { transform: none; }
  .rw-card:hover .rw-card-ring { transform: none; }
}
@media (max-width: 640px) {
  .rw-hero-title { font-size: 1.6rem; }
  .rw-detail-title { font-size: 1.5rem; }
  .rw-masthead-inner { height: 56px; }
  .rw-topnav { gap: 0.85rem; }
  .rw-topnav a { font-size: 0.82rem; }
}
</style>
