<style>
  /* ── Robotics / ML portfolio — standalone micro-site ─────────────
     Design language: the main site's forest green and warm cream carry every
     page (all colour comes off the --global-* theme vars), and the single
     accent is the gaffer orange that is physically on every frame of this
     footage. Orange is reserved for FLOW STATE — the station that is running,
     the rail that has been played, the live row of the TOC — so colour always
     means something. Mono is used for machine labelling (numbers, specs,
     captions, wayfinding), never for prose. */
  body.rbx-site {
    padding: 0;
    --tape: #e8590c;
    --rail: rgba(47, 74, 58, 0.24);
    --mono: ui-monospace, SFMono-Regular, Menlo, monospace;
  }
  html[data-theme='dark'] body.rbx-site {
    --rail: rgba(216, 196, 160, 0.28);
  }
  @media (prefers-reduced-motion: no-preference) {
    html {
      scroll-behavior: smooth;
    }
  }

  /* two-column shell: sticky sidebar + project grid */
  .rbx-wrap {
    display: grid;
    grid-template-columns: 300px minmax(0, 1fr);
    gap: 3.25rem;
    max-width: 1460px;
    margin: 0 auto;
    padding: 2.75rem 2.75rem 4.5rem;
  }

  /* ── sidebar ──────────────────────────────────────────────────────
     The column carries the whole identity — name, capabilities, an index of
     the grid, and the links — and it has to do that inside one screen without
     a scrollbar of its own. So its vertical rhythm is measured in vh: every
     gap and the display sizes shrink with the viewport instead of stacking up
     past the fold. `overflow-y: auto` stays only as a floor for genuinely tiny
     windows and large accessibility text sizes, where clipping the links would
     be worse than a scrollbar. */
  .rbx-side {
    --sgap: clamp(0.8rem, 1.95vh, 1.9rem);
    position: sticky;
    top: 2.25rem;
    align-self: start;
    max-height: calc(100vh - 4.5rem);
    overflow-y: auto;
    scrollbar-width: thin;
    display: flex;
    flex-direction: column;
  }
  .rbx-mark-link {
    display: inline-flex;
    color: var(--global-theme-color);
    /* the mark needs less air than the gaps between content blocks */
    margin-bottom: clamp(0.7rem, 1.5vh, 1.6rem);
  }
  .rbx-mark {
    display: block;
    transition: transform 0.5s cubic-bezier(0.2, 0.8, 0.3, 1);
  }
  .rbx-mark-link:hover .rbx-mark {
    transform: rotate(45deg);
  }
  .rbx-name {
    font-family: var(--mono);
    font-weight: 800;
    font-size: clamp(1.85rem, 3.9vh, 2.45rem);
    line-height: 1.05;
    letter-spacing: -0.02em;
    margin: 0 0 0.55rem;
    color: var(--global-text-color);
  }
  .rbx-sub {
    font-size: clamp(0.87rem, 1.9vh, 0.94rem);
    line-height: 1.45;
    color: var(--global-text-color);
    opacity: 0.62;
    margin: 0;
    max-width: 22rem;
  }
  .rbx-about {
    font-size: clamp(0.76rem, 1.62vh, 0.84rem);
    line-height: 1.45;
    opacity: 0.6;
    margin: 0.5rem 0 0;
  }
  .rbx-about a {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .rbx-about a:hover {
    color: var(--global-theme-color);
  }
  .rbx-uc {
    align-self: flex-start;
    font-family: var(--mono);
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 0.3rem 0.65rem;
    margin-top: 1.1rem;
    border: 1px solid var(--global-divider-color);
    border-radius: 999px;
    opacity: 0.85;
  }

  /* capabilities: run-in labels, so each area costs one paragraph, not a block */
  .rbx-skills {
    margin: var(--sgap) 0 0;
  }
  .rbx-skill {
    font-size: clamp(0.72rem, 1.55vh, 0.77rem);
    line-height: 1.4;
    margin-bottom: clamp(0.18rem, 0.4vh, 0.3rem);
  }
  .rbx-skill:last-child {
    margin-bottom: 0;
  }
  .rbx-skill-label {
    display: inline;
    margin-right: 0.4rem;
    font-family: var(--mono);
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--global-theme-color);
    opacity: 0.95;
  }
  html[data-theme='dark'] .rbx-skill-label {
    opacity: 0.85;
  }
  .rbx-skill-items {
    display: inline;
    margin: 0;
    opacity: 0.58;
  }

  /* numbered index of the page — the grid outgrew one screen */
  .rbx-manifest {
    margin-top: var(--sgap);
  }
  .rbx-manifest-h,
  .rbx-tocrail-h {
    font-family: var(--mono);
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    opacity: 0.45;
    margin: 0 0 0.35rem;
  }
  .rbx-manifest-row {
    display: grid;
    grid-template-columns: 1.9rem minmax(0, 1fr);
    align-items: baseline;
    padding: clamp(0.18rem, 0.42vh, 0.4rem) 0;
    line-height: 1.35;
    color: var(--global-text-color);
    text-decoration: none;
  }
  .rbx-manifest-num {
    font-family: var(--mono);
    font-size: 0.72rem;
    opacity: 0.4;
    transition:
      color 0.15s ease,
      opacity 0.15s ease;
  }
  .rbx-manifest-title {
    font-size: clamp(0.83rem, 1.8vh, 0.89rem);
    font-weight: 500;
    opacity: 0.82;
    transition:
      color 0.15s ease,
      opacity 0.15s ease;
  }
  .rbx-manifest-row:hover {
    text-decoration: none;
  }
  .rbx-manifest-row:hover .rbx-manifest-num,
  .rbx-manifest-row:focus-visible .rbx-manifest-num {
    color: var(--tape);
    opacity: 1;
  }
  .rbx-manifest-row:hover .rbx-manifest-title,
  .rbx-manifest-row:focus-visible .rbx-manifest-title {
    color: var(--global-theme-color);
    opacity: 1;
  }

  /* Links in two columns: five stacked rows cost a fifth of the column height,
     which is the difference between this sidebar fitting a laptop screen and
     not. An odd last link spans the pair so the hairline rules stay even. */
  .rbx-links {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: 1.1rem;
    margin-top: var(--sgap);
  }
  .rbx-link {
    padding: clamp(0.34rem, 0.75vh, 0.72rem) 0;
    border-top: 1px solid var(--global-divider-color);
    color: var(--global-text-color);
    text-decoration: none;
    font-size: clamp(0.83rem, 1.85vh, 0.9rem);
    opacity: 0.85;
    transition:
      opacity 0.15s ease,
      color 0.15s ease;
  }
  .rbx-link:last-child:nth-child(odd) {
    grid-column: 1 / -1;
  }
  .rbx-link:hover {
    opacity: 1;
    color: var(--global-theme-color);
    text-decoration: underline;
  }

  /* ── project grid ─────────────────────────────────────────────── */
  .rbx-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 3rem 2.25rem;
    align-content: start;
  }
  .rbx-card {
    display: block;
    color: var(--global-text-color);
    text-decoration: none;
    scroll-margin-top: 2rem;
  }
  .rbx-card:hover {
    text-decoration: none;
  }

  /* the frame stacks the still + hover preview; the preview fades in ON TOP of
     the still, which never fades out — fading both let the page background
     glow through mid-cross-fade, a visible blink on every play and stop */
  .rbx-frame {
    position: relative;
    display: block;
    overflow: hidden;
    border-radius: 10px;
    border: 1px solid var(--global-divider-color);
    background: var(--global-card-bg-color);
    transition:
      transform 0.35s cubic-bezier(0.2, 0.8, 0.3, 1),
      box-shadow 0.35s cubic-bezier(0.2, 0.8, 0.3, 1);
  }
  .rbx-card:hover .rbx-frame,
  .rbx-card:focus-visible .rbx-frame {
    transform: translateY(-4px);
    box-shadow: 0 18px 40px -18px rgba(0, 0, 0, 0.5);
  }
  .rbx-card:focus-visible .rbx-frame {
    outline: 2px solid var(--global-theme-color);
    outline-offset: 3px;
  }
  .rbx-cover {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    background: var(--global-card-bg-color);
  }
  .rbx-preview {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transition: opacity 0.3s ease;
  }
  .rbx-card.is-playing .rbx-preview {
    opacity: 1;
  }

  /* little play marker, so a card that moves is signposted before you hover */
  .rbx-badge {
    position: absolute;
    right: 0.6rem;
    bottom: 0.6rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.55rem;
    height: 1.55rem;
    padding-left: 0.1rem;
    border-radius: 999px;
    color: #fff;
    background: rgba(0, 0, 0, 0.45);
    backdrop-filter: blur(2px);
    transition: opacity 0.25s ease;
  }
  .rbx-card.is-playing .rbx-badge {
    opacity: 0;
  }

  .rbx-cover-empty {
    border: 1px dashed var(--global-divider-color);
    display: flex;
  }
  .rbx-cover-empty::after {
    content: 'under construction';
    margin: auto;
    font-family: var(--mono);
    font-size: 0.78rem;
    letter-spacing: 0.04em;
    opacity: 0.4;
  }
  .rbx-card.is-empty .rbx-frame {
    background: none;
    border: 0;
  }
  .rbx-card.is-empty:hover .rbx-frame {
    transform: none;
    box-shadow: none;
  }

  .rbx-cap {
    display: block;
    margin-top: 0.85rem;
  }
  .rbx-card-head {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
  }
  .rbx-card-num {
    font-family: var(--mono);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    opacity: 0.38;
    flex-shrink: 0;
  }
  .rbx-card:hover .rbx-card-num {
    color: var(--tape);
    opacity: 1;
  }
  .rbx-card-title {
    font-weight: 650;
    font-size: 1.08rem;
    letter-spacing: -0.005em;
    border-bottom: 1px solid transparent;
  }
  .rbx-card:hover .rbx-card-title {
    border-bottom-color: currentColor;
  }
  .rbx-card-date {
    flex-shrink: 0;
    margin-left: auto;
    font-family: var(--mono);
    font-size: 0.74rem;
    opacity: 0.5;
  }
  .rbx-card-blurb {
    display: block;
    margin-top: 0.35rem;
    font-size: 0.84rem;
    line-height: 1.55;
    opacity: 0.55;
    max-width: 46ch;
  }

  /* ── detail page shell: masthead across, TOC rail left ────────── */
  .rbx-shell {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-template-areas:
      'mast'
      'main';
    max-width: 1280px;
    margin: 0 auto;
    padding: 1.9rem 1.5rem 4.5rem;
  }
  .rbx-mast {
    grid-area: mast;
    margin-bottom: 2.6rem;
    padding-bottom: 1.1rem;
    border-bottom: 1px solid var(--global-divider-color);
  }
  .rbx-mast-brand {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--global-text-color);
    text-decoration: none;
  }
  .rbx-mast-brand .rbx-mark {
    color: var(--global-theme-color);
  }
  .rbx-mast-brand:hover .rbx-mark {
    transform: rotate(45deg);
  }
  .rbx-mast-name {
    font-family: var(--mono);
    font-size: 0.92rem;
    font-weight: 700;
    letter-spacing: -0.01em;
  }
  .rbx-mast-sep {
    font-family: var(--mono);
    opacity: 0.35;
  }
  .rbx-mast-site {
    font-family: var(--mono);
    font-size: 0.92rem;
    opacity: 0.65;
  }
  .rbx-mast-brand:hover .rbx-mast-name {
    color: var(--global-theme-color);
  }
  .rbx-main {
    grid-area: main;
    min-width: 0;
  }

  /* the rail TOC — hidden until there is room for it beside the content */
  .rbx-tocrail {
    display: none;
  }
  @media (min-width: 1080px) {
    .rbx-shell {
      grid-template-columns: 236px minmax(0, 1fr);
      grid-template-areas:
        'mast mast'
        'toc  main';
      column-gap: 3.5rem;
    }
    .rbx-tocrail {
      display: block;
      grid-area: toc;
      position: sticky;
      top: 1.9rem;
      align-self: start;
      max-height: calc(100vh - 3.8rem);
      overflow-y: auto;
      scrollbar-width: thin;
      padding-right: 0.4rem;
    }
    /* the rail replaces the chip TOC where both would render (extra specificity:
       the chip TOC's own display:flex rule sits later in the cascade) */
    .rbx-flow-head .rbx-toc {
      display: none;
    }
  }
  .rbx-tocrail-list {
    list-style: none;
    margin: 0;
    padding: 0;
    position: relative;
  }
  /* the spine: same hairline as the station rail, so the TOC reads as a
     miniature of the page's own diagram */
  .rbx-tocrail-list::before {
    content: '';
    position: absolute;
    left: 10px;
    top: 8px;
    bottom: 8px;
    width: 1.5px;
    background: var(--rail);
  }
  .rbx-tocrail-item {
    position: relative;
  }
  .rbx-tocrail-link {
    display: grid;
    grid-template-columns: 21px minmax(0, 1fr);
    column-gap: 0.65rem;
    align-items: baseline;
    padding: 0.3rem 0;
    color: var(--global-text-color);
    text-decoration: none;
  }
  .rbx-tocrail-marker {
    position: relative;
    z-index: 1;
    justify-self: center;
    font-family: var(--mono);
    font-size: 0.66rem;
    font-weight: 700;
    line-height: 1.3;
    text-align: center;
    min-width: 15px;
    border-radius: 999px;
    background: var(--global-bg-color);
    color: var(--global-text-color);
    opacity: 0.55;
    transition:
      color 0.2s ease,
      background 0.2s ease,
      opacity 0.2s ease;
  }
  /* rows without a step number get a dot on the spine instead */
  .rbx-tocrail-item.is-plain .rbx-tocrail-marker,
  .rbx-tocrail-item.is-branch .rbx-tocrail-marker {
    width: 9px;
    min-width: 9px;
    height: 9px;
    align-self: center;
    border: 1.5px solid var(--rail);
    opacity: 1;
  }
  .rbx-tocrail-item.is-branch .rbx-tocrail-marker {
    border-style: dashed;
  }
  .rbx-tocrail-label {
    font-size: 0.84rem;
    line-height: 1.4;
    opacity: 0.6;
    transition: opacity 0.2s ease;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .rbx-tocrail-link:hover .rbx-tocrail-label,
  .rbx-tocrail-link:focus-visible .rbx-tocrail-label {
    opacity: 1;
  }
  .rbx-tocrail-link:focus-visible {
    outline: 2px solid var(--global-theme-color);
    outline-offset: 2px;
    border-radius: 4px;
  }
  /* scroll-spy position */
  .rbx-tocrail-item.is-here .rbx-tocrail-label {
    opacity: 1;
    font-weight: 600;
  }
  .rbx-tocrail-item.is-here .rbx-tocrail-marker {
    color: var(--tape);
    opacity: 1;
  }
  .rbx-tocrail-item.is-plain.is-here .rbx-tocrail-marker,
  .rbx-tocrail-item.is-branch.is-here .rbx-tocrail-marker {
    border-color: var(--tape);
    background: var(--tape);
  }
  /* flow state, mirrored off the stations while the run plays */
  .rbx-tocrail-item.is-played .rbx-tocrail-marker {
    color: var(--tape);
    opacity: 0.85;
  }
  .rbx-tocrail-item.is-live .rbx-tocrail-marker {
    background: var(--tape);
    color: #1f3329;
    opacity: 1;
  }
  .rbx-tocrail-item.is-branch.is-live .rbx-tocrail-marker {
    border-color: var(--tape);
    background: var(--tape);
  }

  /* ── project header ───────────────────────────────────────────── */
  .rbx-flow-head {
    max-width: 62ch;
    margin-bottom: 2.75rem;
  }
  .rbx-flow-title {
    font-family: var(--mono);
    font-weight: 800;
    font-size: clamp(2rem, 4.6vw, 3.15rem);
    line-height: 1.02;
    letter-spacing: -0.03em;
    margin: 0;
  }
  .rbx-flow-tag {
    font-size: clamp(1rem, 1.6vw, 1.18rem);
    line-height: 1.5;
    margin: 0.7rem 0 0;
    opacity: 0.72;
  }
  .rbx-flow-intro {
    font-size: clamp(1rem, 1.5vw, 1.08rem);
    line-height: 1.6;
    margin: 1.1rem 0 0;
    opacity: 0.85;
  }
  .rbx-specs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    list-style: none;
    margin: 1.25rem 0 0;
    padding: 0;
  }
  .rbx-spec {
    font-family: var(--mono);
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 0.32rem 0.6rem;
    border: 1px solid var(--rail);
    border-radius: 999px;
    opacity: 0.75;
  }
  .rbx-flow-notes {
    font-size: 0.98rem;
    line-height: 1.62;
    margin: 1.4rem 0 0;
    opacity: 0.8;
  }
  .rbx-flow-ctl {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    margin-top: 1.6rem;
  }
  .rbx-flow-play {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    font-family: var(--mono);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #1f3329;
    background: var(--tape);
    border: 0;
    border-radius: 999px;
    padding: 0.6rem 1.1rem;
    cursor: pointer;
  }
  .rbx-flow-play:hover {
    filter: brightness(1.08);
  }
  .rbx-flow-play:focus-visible {
    outline: 2px solid var(--global-text-color);
    outline-offset: 3px;
  }
  .rbx-flow-play-ico {
    width: 0;
    height: 0;
    border-left: 8px solid currentColor;
    border-top: 5px solid transparent;
    border-bottom: 5px solid transparent;
  }
  .rbx-flow-play.is-on .rbx-flow-play-ico {
    width: 8px;
    height: 10px;
    border: 0;
    background: currentColor;
    clip-path: polygon(0 0, 33% 0, 33% 100%, 0 100%, 0 0, 67% 0, 100% 0, 100% 100%, 67% 100%, 67% 0);
  }
  .rbx-flow-hint {
    font-size: 0.8rem;
    opacity: 0.5;
    margin: 0;
  }
  /* the same pill as a link that jumps down the page (titled gallery) */
  .rbx-jump,
  .rbx-jump:hover,
  .rbx-jump:focus-visible {
    color: #1f3329;
    text-decoration: none;
  }
  .rbx-jump-ico {
    width: 0;
    height: 0;
    border-top: 8px solid currentColor;
    border-left: 5px solid transparent;
    border-right: 5px solid transparent;
  }

  /* ── stations ─────────────────────────────────────────────────── */
  .rbx-flow {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .rbx-stn {
    display: grid;
    grid-template-columns: 34px minmax(0, 1fr);
    gap: 0 1.25rem;
    scroll-margin-top: 1.25rem;
  }
  .rbx-stn-rail {
    display: grid;
    grid-template-rows: auto 1fr;
    justify-items: center;
  }
  .rbx-stn-dot {
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    font-family: var(--mono);
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--global-text-color);
    background: var(--global-bg-color);
    border: 1.5px solid var(--rail);
    transition: all 0.25s ease;
  }
  .rbx-stn-line {
    width: 2px;
    background: var(--rail);
    min-height: 100%;
    position: relative;
  }
  /* the arrowhead that makes this a path and not a list */
  .rbx-stn-line::after {
    content: '';
    position: absolute;
    left: 50%;
    bottom: 6px;
    transform: translateX(-50%);
    border-top: 7px solid var(--rail);
    border-left: 5px solid transparent;
    border-right: 5px solid transparent;
    transition: border-top-color 0.25s ease;
  }
  .rbx-stn.is-branch .rbx-stn-line,
  .rbx-stn.is-branch + .rbx-stn .rbx-stn-line {
    background: repeating-linear-gradient(to bottom, var(--rail) 0 5px, transparent 5px 11px);
  }
  .rbx-stn.is-branch .rbx-stn-dot {
    width: 20px;
    height: 20px;
    margin-top: 5px;
    border-style: dashed;
  }
  /* played-through state */
  .rbx-stn.is-done .rbx-stn-dot {
    border-color: var(--tape);
    color: var(--tape);
  }
  .rbx-stn.is-done .rbx-stn-line {
    background: var(--tape);
  }
  .rbx-stn.is-done .rbx-stn-line::after {
    border-top-color: var(--tape);
  }
  .rbx-stn.is-on .rbx-stn-dot {
    background: var(--tape);
    border-color: var(--tape);
    color: #1f3329;
    box-shadow: 0 0 0 5px rgba(232, 89, 12, 0.18);
  }
  .rbx-stn-card {
    display: grid;
    grid-template-columns: minmax(0, 210px) minmax(0, 1fr);
    gap: 1.4rem;
    align-items: start;
    padding-bottom: 2.6rem;
  }
