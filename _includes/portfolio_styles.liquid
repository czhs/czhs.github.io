<style>
  /* ── Robotics / ML portfolio — standalone micro-site ─────────────
     Design language (2026-08-26 redesign): the ZINE. The portfolio now wears
     the same skin as the main site — one ivory sheet with a thick ink border
     sitting on the seafoam field, Plus Jakarta Sans for prose and display,
     JetBrains Mono strictly for machine labelling (numbers, specs, captions,
     wayfinding). The palette is the zine's default seafoam, fixed: this site
     is handed to people hiring, so it always looks the same. No dark mode —
     one palette per visitor, like the rest of the site.

     The single accent stays the gaffer orange that is physically on every
     frame of this footage. Orange is reserved for FLOW STATE — the station
     that is running, the rail that has been played, the live row of the TOC —
     so colour always means something.

     Shape language, from the zine: squared corners, real ink borders, hard
     offset shadows (never soft blur), and no transform under the cursor —
     moving an element under the pointer cancels its own hover at the edge. */

  /* Self-hosted fonts, same files as the main site (see zine_palette.liquid
     for the measurement notes behind the metric-matched fallbacks). */
  @font-face {
    font-family: 'Plus Jakarta Sans';
    font-style: normal;
    font-weight: 200 800;
    font-display: swap;
    src: url('{{ '/assets/fonts/plus-jakarta-sans-latin-var.woff2' | relative_url }}') format('woff2');
  }
  @font-face {
    font-family: 'JetBrains Mono';
    font-style: normal;
    font-weight: 100 800;
    font-display: swap;
    src: url('{{ '/assets/fonts/jetbrains-mono-latin-var.woff2' | relative_url }}') format('woff2');
  }
  @font-face {
    font-family: 'PJS Fallback';
    src: local('Arial'), local('Helvetica'), local('Liberation Sans');
    size-adjust: 106.07%;
    ascent-override: 94.28%;
    descent-override: 24.51%;
    line-gap-override: 0%;
  }
  @font-face {
    font-family: 'JBM Fallback';
    src: local('Menlo'), local('Consolas'), local('DejaVu Sans Mono'), local('Courier New');
    size-adjust: 100%;
    ascent-override: 102%;
    descent-override: 30%;
    line-gap-override: 0%;
  }

  body.rbx-site {
    /* zine seafoam, fixed (copied literals from zine_palette.liquid; keep in sync) */
    --rbx-field: #8fb2a4;
    --rbx-ink: #13261f;
    --rbx-card: #fffcf2;
    --rbx-accent: #0f6046;
    --tape: #e8590c;
    --rail: color-mix(in srgb, var(--rbx-ink) 26%, transparent);
    --line: color-mix(in srgb, var(--rbx-ink) 18%, transparent);
    --ink-soft: color-mix(in srgb, var(--rbx-ink) 62%, transparent);
    --rbx-sans: 'Plus Jakarta Sans', 'PJS Fallback', 'Segoe UI', Roboto, sans-serif;
    --rbx-mono: 'JetBrains Mono', 'JBM Fallback', ui-monospace, 'SF Mono', Menlo, Consolas, monospace;
    --mono: var(--rbx-mono);
    /* field visible around the sheet, and the sheet's own inner padding */
    --shm: clamp(0.75rem, 2.5vw, 2.25rem);
    --shp: clamp(1.25rem, 3vw, 2.75rem);

    /* remap the theme vars so anything still reading --global-* (focus rings,
       back-to-top, stray al-folio rules) tracks the zine palette too */
    color-scheme: light;
    --global-bg-color: var(--rbx-card);
    --global-text-color: var(--rbx-ink);
    --global-text-color-light: var(--ink-soft);
    --global-theme-color: var(--rbx-accent);
    --global-hover-color: var(--rbx-accent);
    --global-hover-text-color: var(--rbx-card);
    --global-divider-color: var(--line);
    --global-card-bg-color: var(--rbx-card);

    padding: 0;
    background: var(--rbx-field);
    color: var(--rbx-ink);
    font-family: var(--rbx-sans);
  }
  html:has(body.rbx-site) {
    background: var(--rbx-field);
    scrollbar-gutter: stable;
  }
  @media (prefers-reduced-motion: no-preference) {
    html {
      scroll-behavior: smooth;
    }
  }

  /* ── reveal choreography ─────────────────────────────────────────
     .rbx-armed lands on <html> before first paint (script in
     portfolio_base.liquid) and only when motion is allowed, so without JS —
     or with reduced motion — nothing is ever hidden. .rbx-ready follows at
     once from the same file; the observer in portfolio_base.liquid stamps
     .is-in as things reach the viewport. */
  html.rbx-armed :is([data-rv], .rbx-stn, .rbx-shot, .rbx-pager) {
    opacity: 0;
    transform: translateY(10px);
  }
  html.rbx-armed.rbx-ready :is([data-rv], .rbx-stn, .rbx-shot, .rbx-pager) {
    /* a short rise on a long expo-out tail: most of the distance is covered
       early, the settle is gentle — a bigger translate on a snappier curve
       read as choppy */
    transition:
      opacity 0.55s ease,
      transform 0.7s cubic-bezier(0.16, 1, 0.3, 1);
    transition-delay: var(--rv, 0ms);
  }
  html.rbx-armed.rbx-ready :is([data-rv], .rbx-stn, .rbx-shot, .rbx-pager).is-in {
    opacity: 1;
    transform: none;
  }
  /* Inside the sticky sidebar the stagger is fade-only: translating its
     children makes the column momentarily taller than its max-height, which
     flashes a scrollbar on every load. The column itself carries the rise. */
  html.rbx-armed .rbx-side [data-rv] {
    transform: none;
  }

  /* ── the sheet: two-column shell, ink border, field around it ─── */
  .rbx-wrap {
    display: grid;
    grid-template-columns: 300px minmax(0, 1fr);
    gap: 3.25rem;
    width: min(1500px, calc(100% - var(--shm) * 2));
    margin: var(--shm) auto;
    padding: var(--shp);
    background: var(--rbx-card);
    border: 8px solid var(--rbx-ink);
  }

  /* ── sidebar ──────────────────────────────────────────────────────
     The column carries the whole identity — name, capabilities, an index of
     the grid, and the links — and it has to do that inside one screen without
     a scrollbar of its own. So its vertical rhythm is measured in vh: every
     gap and the display sizes shrink with the viewport instead of stacking up
     past the fold. `overflow-y: auto` stays only as a floor for genuinely tiny
     windows and large accessibility text sizes, where clipping the links would
     be worse; the rail itself is hidden (still scrollable) so the column never
     shows a scrollbar. */
  .rbx-side {
    --sgap: clamp(0.8rem, 1.95vh, 1.9rem);
    position: sticky;
    top: clamp(1.25rem, 3vh, 2.25rem);
    align-self: start;
    max-height: calc(100vh - 4.5rem);
    overflow-y: auto;
    scrollbar-width: none;
    display: flex;
    flex-direction: column;
  }
  .rbx-side::-webkit-scrollbar {
    display: none;
  }
  .rbx-name {
    font-weight: 800;
    font-size: clamp(2.1rem, 4.4vh, 2.7rem);
    line-height: 1;
    letter-spacing: -0.035em;
    margin: 0 0 0.55rem;
    color: var(--rbx-ink);
  }
  .rbx-name-dot {
    color: var(--rbx-accent);
  }
  .rbx-sub {
    font-size: clamp(0.87rem, 1.9vh, 0.94rem);
    font-weight: 500;
    line-height: 1.45;
    color: var(--ink-soft);
    margin: 0;
    max-width: 22rem;
  }
  .rbx-about {
    font-size: clamp(0.76rem, 1.62vh, 0.84rem);
    line-height: 1.45;
    color: var(--ink-soft);
    margin: 0.5rem 0 0;
  }
  .rbx-about a {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-thickness: 1.5px;
    font-weight: 600;
  }
  .rbx-about a:hover {
    color: var(--rbx-accent);
  }
  .rbx-uc {
    align-self: flex-start;
    font-family: var(--rbx-mono);
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 0.3rem 0.65rem;
    margin-top: 1.1rem;
    border: 2px solid var(--rbx-ink);
    opacity: 0.85;
  }

  /* capabilities: run-in labels, so each area costs one paragraph, not a block */
  .rbx-skills {
    margin: var(--sgap) 0 0;
  }
  .rbx-skill {
    font-size: clamp(0.72rem, 1.55vh, 0.77rem);
    line-height: 1.4;
    margin-bottom: clamp(0.18rem, 0.4vh, 0.3rem);
  }
  .rbx-skill:last-child {
    margin-bottom: 0;
  }
  .rbx-skill-label {
    display: inline;
    margin-right: 0.4rem;
    font-family: var(--rbx-mono);
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--rbx-accent);
  }
  .rbx-skill-items {
    display: inline;
    margin: 0;
    color: var(--ink-soft);
  }

  /* numbered index of the page — the grid outgrew one screen */
  .rbx-manifest {
    margin-top: var(--sgap);
  }
  .rbx-manifest-h,
  .rbx-tocrail-h {
    font-family: var(--rbx-mono);
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-soft);
    margin: 0 0 0.35rem;
  }
  .rbx-manifest-row {
    display: grid;
    grid-template-columns: 1.9rem minmax(0, 1fr);
    align-items: baseline;
    padding: clamp(0.18rem, 0.42vh, 0.4rem) 0;
    line-height: 1.35;
    color: var(--rbx-ink);
    text-decoration: none;
  }
  .rbx-manifest-num {
    font-family: var(--rbx-mono);
    font-size: 0.72rem;
    opacity: 0.4;
    transition:
      color 0.15s ease,
      opacity 0.15s ease;
  }
  .rbx-manifest-title {
    font-size: clamp(0.83rem, 1.8vh, 0.89rem);
    font-weight: 600;
    opacity: 0.82;
    transition:
      color 0.15s ease,
      opacity 0.15s ease;
  }
  .rbx-manifest-row:hover {
    text-decoration: none;
  }
  .rbx-manifest-row:hover .rbx-manifest-num,
  .rbx-manifest-row:focus-visible .rbx-manifest-num {
    color: var(--tape);
    opacity: 1;
  }
  .rbx-manifest-row:hover .rbx-manifest-title,
  .rbx-manifest-row:focus-visible .rbx-manifest-title {
    color: var(--rbx-accent);
    opacity: 1;
  }

  /* Links in two columns: five stacked rows cost a fifth of the column height,
     which is the difference between this sidebar fitting a laptop screen and
     not. An odd last link spans the pair so the hairline rules stay even. */
  .rbx-links {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: 1.1rem;
    margin-top: var(--sgap);
  }
  .rbx-link {
    padding: clamp(0.34rem, 0.75vh, 0.72rem) 0;
    border-top: 1.5px solid var(--line);
    color: var(--rbx-ink);
    text-decoration: none;
    font-size: clamp(0.83rem, 1.85vh, 0.9rem);
    font-weight: 600;
    opacity: 0.85;
    transition:
      opacity 0.15s ease,
      color 0.15s ease;
  }
  .rbx-link:last-child:nth-child(odd) {
    grid-column: 1 / -1;
  }
  .rbx-link:hover {
    opacity: 1;
    color: var(--rbx-accent);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  /* ── project grid ─────────────────────────────────────────────── */
  .rbx-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 3rem 2.25rem;
    align-content: start;
  }
  .rbx-card {
    display: block;
    color: var(--rbx-ink);
    text-decoration: none;
    scroll-margin-top: 2rem;
  }
  .rbx-card:hover {
    text-decoration: none;
  }

  /* the frame stacks the still + hover preview; the preview fades in ON TOP of
     the still, which never fades out — fading both let the page background
     glow through mid-cross-fade, a visible blink on every play and stop.
     Hover is a hard offset shadow, zine-style: shadow only, no translate. */
  .rbx-frame {
    position: relative;
    display: block;
    overflow: hidden;
    border: 3px solid var(--rbx-ink);
    background: var(--rbx-card);
    transition: box-shadow 0.18s ease;
  }
  .rbx-card:hover .rbx-frame,
  .rbx-card:focus-visible .rbx-frame {
    box-shadow: 7px 7px 0 color-mix(in srgb, var(--rbx-ink) 55%, transparent);
  }
  .rbx-card:focus-visible .rbx-frame {
    outline: 2px solid var(--rbx-accent);
    outline-offset: 3px;
  }
  .rbx-cover {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    background: var(--rbx-card);
  }
  .rbx-preview {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transition: opacity 0.3s ease;
  }
  .rbx-card.is-playing .rbx-preview {
    opacity: 1;
  }

  /* little play marker, so a card that moves is signposted before you hover */
  .rbx-badge {
    position: absolute;
    right: 0;
    bottom: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.6rem;
    height: 1.6rem;
    padding-left: 0.1rem;
    color: var(--rbx-card);
    background: var(--rbx-ink);
    transition: opacity 0.25s ease;
  }
  .rbx-card.is-playing .rbx-badge {
    opacity: 0;
  }

  .rbx-cover-empty {
    border: 2px dashed var(--rail);
    display: flex;
  }
  .rbx-cover-empty::after {
    content: 'under construction';
    margin: auto;
    font-family: var(--rbx-mono);
    font-size: 0.78rem;
    letter-spacing: 0.04em;
    opacity: 0.4;
  }
  .rbx-card.is-empty .rbx-frame {
    background: none;
    border: 0;
  }
  .rbx-card.is-empty:hover .rbx-frame {
    box-shadow: none;
  }

  .rbx-cap {
    display: block;
    margin-top: 0.85rem;
  }
  .rbx-card-head {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
  }
  .rbx-card-num {
    font-family: var(--rbx-mono);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    opacity: 0.38;
    flex-shrink: 0;
  }
  .rbx-card:hover .rbx-card-num {
    color: var(--tape);
    opacity: 1;
  }
  .rbx-card-title {
    font-weight: 700;
    font-size: 1.1rem;
    letter-spacing: -0.015em;
    border-bottom: 2px solid transparent;
  }
  .rbx-card:hover .rbx-card-title {
    border-bottom-color: currentColor;
  }
  .rbx-card-date {
    flex-shrink: 0;
    margin-left: auto;
    font-family: var(--rbx-mono);
    font-size: 0.74rem;
    opacity: 0.5;
  }
  .rbx-card-blurb {
    display: block;
    margin-top: 0.35rem;
    font-size: 0.84rem;
    line-height: 1.55;
    color: var(--ink-soft);
    max-width: 46ch;
  }

  /* ── detail page shell: masthead across, TOC rail left ────────── */
  .rbx-shell {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-template-areas:
      'mast'
      'main';
    width: min(1280px, calc(100% - var(--shm) * 2));
    margin: var(--shm) auto;
    padding: clamp(1.25rem, 2.6vw, 2.4rem) var(--shp) 4rem;
    background: var(--rbx-card);
    border: 8px solid var(--rbx-ink);
  }
  .rbx-mast {
    grid-area: mast;
    margin-bottom: 2.6rem;
    padding-bottom: 1.1rem;
    border-bottom: 2px solid var(--line);
  }
  .rbx-mast-brand {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--rbx-ink);
    text-decoration: none;
  }
  .rbx-mast-name {
    font-family: var(--rbx-mono);
    font-size: 0.92rem;
    font-weight: 700;
    letter-spacing: -0.01em;
  }
  .rbx-mast-sep {
    font-family: var(--rbx-mono);
    opacity: 0.35;
  }
  .rbx-mast-site {
    font-family: var(--rbx-mono);
    font-size: 0.92rem;
    opacity: 0.65;
  }
  .rbx-mast-brand:hover .rbx-mast-name {
    color: var(--rbx-accent);
  }
  .rbx-main {
    grid-area: main;
    min-width: 0;
  }

  /* the rail TOC — hidden until there is room for it beside the content */
  .rbx-tocrail {
    display: none;
  }
  @media (min-width: 1080px) {
    .rbx-shell {
      grid-template-columns: 236px minmax(0, 1fr);
      grid-template-areas:
        'mast mast'
        'toc  main';
      column-gap: 3.5rem;
    }
    .rbx-tocrail {
      display: block;
      grid-area: toc;
      position: sticky;
      top: 1.9rem;
      align-self: start;
      max-height: calc(100vh - 3.8rem);
      overflow-y: auto;
      /* scrollable, but no visible rail of its own */
      scrollbar-width: none;
      padding-right: 0.4rem;
    }
    .rbx-tocrail::-webkit-scrollbar {
      display: none;
    }
    /* the rail replaces the chip TOC where both would render (extra specificity:
       the chip TOC's own display:flex rule sits later in the cascade) */
    .rbx-flow-head .rbx-toc {
      display: none;
    }
  }
  .rbx-tocrail-list {
    list-style: none;
    margin: 0;
    padding: 0;
    position: relative;
  }
  /* the spine: same hairline as the station rail, so the TOC reads as a
     miniature of the page's own diagram */
  .rbx-tocrail-list::before {
    content: '';
    position: absolute;
    left: 10px;
    top: 8px;
    bottom: 8px;
    width: 1.5px;
    background: var(--rail);
  }
  .rbx-tocrail-item {
    position: relative;
  }
  .rbx-tocrail-link {
    display: grid;
    grid-template-columns: 21px minmax(0, 1fr);
    column-gap: 0.65rem;
    align-items: baseline;
    padding: 0.3rem 0;
    color: var(--rbx-ink);
    text-decoration: none;
  }
  .rbx-tocrail-marker {
    position: relative;
    z-index: 1;
    justify-self: center;
    font-family: var(--rbx-mono);
    font-size: 0.66rem;
    font-weight: 700;
    line-height: 1.3;
    text-align: center;
    min-width: 15px;
    border-radius: 999px;
    background: var(--rbx-card);
    color: var(--rbx-ink);
    opacity: 0.55;
    transition:
      color 0.2s ease,
      background 0.2s ease,
      opacity 0.2s ease;
  }
  /* rows without a step number get a dot on the spine instead */
  .rbx-tocrail-item.is-plain .rbx-tocrail-marker,
  .rbx-tocrail-item.is-branch .rbx-tocrail-marker {
    width: 9px;
    min-width: 9px;
    height: 9px;
    align-self: center;
    border: 1.5px solid var(--rail);
    opacity: 1;
  }
  .rbx-tocrail-item.is-branch .rbx-tocrail-marker {
    border-style: dashed;
  }
  .rbx-tocrail-label {
    font-size: 0.84rem;
    line-height: 1.4;
    opacity: 0.6;
    transition: opacity 0.2s ease;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .rbx-tocrail-link:hover .rbx-tocrail-label,
  .rbx-tocrail-link:focus-visible .rbx-tocrail-label {
    opacity: 1;
  }
  .rbx-tocrail-link:focus-visible {
    outline: 2px solid var(--rbx-accent);
    outline-offset: 2px;
  }
  /* scroll-spy position */
  .rbx-tocrail-item.is-here .rbx-tocrail-label {
    opacity: 1;
    font-weight: 600;
  }
  .rbx-tocrail-item.is-here .rbx-tocrail-marker {
    color: var(--tape);
    opacity: 1;
  }
  .rbx-tocrail-item.is-plain.is-here .rbx-tocrail-marker,
  .rbx-tocrail-item.is-branch.is-here .rbx-tocrail-marker {
    border-color: var(--tape);
    background: var(--tape);
  }
  /* flow state, mirrored off the stations while the run plays */
  .rbx-tocrail-item.is-played .rbx-tocrail-marker {
    color: var(--tape);
    opacity: 0.85;
  }
  .rbx-tocrail-item.is-live .rbx-tocrail-marker {
    background: var(--tape);
    color: var(--rbx-ink);
    opacity: 1;
  }
  .rbx-tocrail-item.is-branch.is-live .rbx-tocrail-marker {
    border-color: var(--tape);
    background: var(--tape);
  }

  /* ── project header ───────────────────────────────────────────── */
  .rbx-flow-head {
    max-width: 62ch;
    margin-bottom: 2.75rem;
  }
  .rbx-flow-title {
    font-weight: 800;
    font-size: clamp(2rem, 4.6vw, 3.15rem);
    line-height: 1.02;
    letter-spacing: -0.03em;
    margin: 0;
  }
  .rbx-flow-tag {
    font-size: clamp(1rem, 1.6vw, 1.18rem);
    line-height: 1.5;
    margin: 0.7rem 0 0;
    color: var(--ink-soft);
  }
  .rbx-flow-intro {
    font-size: clamp(1rem, 1.5vw, 1.08rem);
    line-height: 1.6;
    margin: 1.1rem 0 0;
    color: color-mix(in srgb, var(--rbx-ink) 85%, transparent);
  }
  .rbx-specs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    list-style: none;
    margin: 1.25rem 0 0;
    padding: 0;
  }
  .rbx-spec {
    font-family: var(--rbx-mono);
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 0.32rem 0.6rem;
    border: 2px solid var(--rail);
    color: color-mix(in srgb, var(--rbx-ink) 80%, transparent);
  }
  .rbx-flow-notes {
    font-size: 0.98rem;
    line-height: 1.62;
    margin: 1.4rem 0 0;
    color: color-mix(in srgb, var(--rbx-ink) 80%, transparent);
  }
  .rbx-flow-ctl {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    margin-top: 1.6rem;
  }
  .rbx-flow-play {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
