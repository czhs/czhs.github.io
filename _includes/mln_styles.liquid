<style>
/* ── MLn Reading Club — standalone micro-site ─────────────── */

/* shell: a single centered column for masthead, content, footer */
.mln-shell {
  width: 100%;
  max-width: 940px;
  margin: 0 auto;
  padding-left: 1.25rem;
  padding-right: 1.25rem;
}
body.mln-site { padding: 0; }

/* masthead */
.mln-masthead {
  position: sticky;
  top: 0;
  z-index: 50;
  background: var(--global-bg-color);
  border-bottom: 1px solid var(--global-divider-color);
  backdrop-filter: saturate(180%) blur(6px);
}
.mln-masthead-inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 62px;
}
.mln-brand {
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  text-decoration: none;
  color: var(--global-text-color);
}
.mln-brand:hover { text-decoration: none; }
/* The brand is the club's own artwork rather than type: the dot ring and the
   MLn lettering are cut from assets/img/mln_og.png as alpha-only shapes and
   applied as CSS masks over currentColor, so they take the theme colour and
   invert correctly in dark mode. */
.mln-brand-ring {
  display: block;
  flex: 0 0 auto;
  width: 26px;
  height: 26px;
  background: var(--global-theme-color);
  -webkit-mask: url("{{ '/assets/img/mln_mark.png' | relative_url }}") center / contain no-repeat;
  mask: url("{{ '/assets/img/mln_mark.png' | relative_url }}") center / contain no-repeat;
}
.mln-brand-mark {
  display: block;
  width: 62px;
  height: 24px;
  background: currentColor;
  -webkit-mask: url("{{ '/assets/img/mln_wordmark.png' | relative_url }}") left center / contain no-repeat;
  mask: url("{{ '/assets/img/mln_wordmark.png' | relative_url }}") left center / contain no-repeat;
}
.mln-brand-sub {
  font-family: var(--global-code-font-family, monospace);
  font-size: 0.8rem;
  letter-spacing: 0.04em;
  text-transform: uppercase;
  opacity: 0.75;
}
.mln-topnav {
  display: flex;
  align-items: center;
  gap: 1.1rem;
}
.mln-topnav a {
  font-size: 0.88rem;
  font-weight: 500;
  color: var(--global-text-color);
  text-decoration: none;
  opacity: 0.8;
  transition: opacity 0.15s ease, color 0.15s ease;
}
.mln-topnav a:hover { opacity: 1; color: var(--global-theme-color); text-decoration: none; }

/* the sibling club: carries ringworld's own drawn ring and sits as a pill, so
   the link between the two micro-sites reads as a place to go rather than a
   word. The ring is full-colour art, so it stays an <img> rather than a mask.

   The pill is painted in ringworld's palette, not this site's: cream paper and
   cornflower ink, so it reads as a scrap of the other club torn onto this page
   — a filled button among plain nav words, and the cream is also the ground the
   crayon ring was drawn on, so the mark stops floating on dark green. Hexes are
   copied from body.rw-site in ringworld_styles.liquid, whose vars don't reach
   this page; keep them in sync. Selectors are .mln-topnav-qualified so they
   outrank the plain nav link colour and its hover. */
.mln-topnav a.mln-sibling {
  --rw-paper: #fef9f0;
  --rw-card: #fffdf7;
  --rw-ring: #3e6fb4;
  display: inline-flex;
  align-items: center;
  justify-content: flex-start;
  gap: 0.45rem;
  /* Fixed width, and last in the nav, so the pill's right edge is pinned by the
     shell and its left edge — where the mark sits — is identical on both sites.
     Keep in sync with .rw-sibling. Colour is free to differ; the box is not. */
  min-width: 132px;
  height: 32px;
  padding: 0 0.72rem 0 0.6rem;
  border: 1px solid rgba(62, 111, 180, 0.45);
  border-radius: 999px;
  background: var(--rw-paper);
  color: var(--rw-ring);
  font-weight: 700;
  opacity: 1;
  box-shadow: 0 1px 2px rgba(36, 48, 63, 0.14);
  transition: box-shadow 0.15s ease, border-color 0.15s ease, background 0.15s ease;
}
.mln-topnav a.mln-sibling:hover {
  border-color: var(--rw-ring);
  background: var(--rw-card);
  color: var(--rw-ring);
  box-shadow: 0 3px 10px rgba(62, 111, 180, 0.3);
}
.mln-sibling-ico {
  /* fixed 24px slot, mark centred in it — the icons have different aspect
     ratios, so the slot is what actually aligns */
  display: block;
  width: 24px;
  height: 16px;
  object-fit: contain;
  flex: 0 0 auto;
}
/* the label is ringworld's hand lettering rather than the word set in type,
   masked over the pill's cornflower so it follows the hover colour. The source
   art is 4:1; keep the box that ratio or the letters distort.

   `color: inherit` is load-bearing: al-folio's main.css sets a colour on bare
   `span`, which beats inheritance, so currentColor here resolved to the site's
   text colour — cream on the dark theme, all but invisible on the cream pill. */
.mln-sibling-mark {
  display: block;
  flex: 0 0 auto;
  width: 68px;
  height: 17px;
  color: inherit;
  background: currentColor;
  -webkit-mask: url("{{ '/assets/img/ringworld/wordmark.png' | relative_url }}") left center / contain no-repeat;
  mask: url("{{ '/assets/img/ringworld/wordmark.png' | relative_url }}") left center / contain no-repeat;
}

/* main + footer spacing */
.mln-main { padding-top: 1.5rem; padding-bottom: 3.5rem; min-height: 60vh; }
.mln-foot {
  border-top: 1px solid var(--global-divider-color);
  padding: 1.5rem 0;
  margin-top: 2rem;
}
.mln-foot-inner {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 0.5rem;
  font-size: 0.82rem;
  opacity: 0.75;
}
.mln-foot-name { font-weight: 700; opacity: 1; }
.mln-foot-dot { opacity: 0.5; }
.mln-foot-by { margin-left: auto; color: var(--global-theme-color); text-decoration: none; }
.mln-foot-by:hover { text-decoration: underline; }

/* hero (landing) */
.mln-hero { margin: 0 0 1.35rem; }
.mln-hero-title {
  font-size: 1.85rem;
  font-weight: 800;
  letter-spacing: -0.02em;
  line-height: 1.08;
  margin: 0 0 0.5rem;
}
.mln-hero-lead {
  font-size: 0.95rem;
  line-height: 1.5;
  opacity: 0.9;
  max-width: 660px;
  margin: 0 0 0.85rem;
}

/* intro / hero (legacy) */
.mln-intro {
  margin: -0.25rem 0 1.75rem;
  font-size: 0.98rem;
  line-height: 1.6;
  opacity: 0.9;
}
/* One row instead of three stacked full-width bands. The toggle is in normal
   flow at the left; the chips are pinned to the top-right and out of it, which
   is what keeps the summary still when the panel opens — the same spot opens
   and closes it. */
.mln-metarow {
  position: relative;
  margin: 0 0 1.4rem;
  padding-bottom: 0.55rem;
  border-bottom: 1px solid var(--global-divider-color);
  font-family: var(--global-code-font-family, monospace);
  font-size: 0.8rem;
}
.mln-metachips {
  position: absolute;
  top: 0;
  right: 0;
  display: flex;
  flex-wrap: wrap;
  justify-content: flex-end;
  /* Out of flow, so nothing stops these colliding with the toggle — and the
     shell is capped at 940px, so no breakpoint helps. Reserve the toggle's
     width; an overrun then wraps at the right rather than sliding under it. */
  max-width: calc(100% - 180px);
  gap: 0.5rem;
}
@media (max-width: 900px) {
  .mln-metachips {
    position: static;
    flex-wrap: wrap;
    margin-top: 0.65rem;
  }
}
.mln-chip {
  display: inline-flex;
  align-items: center;
  min-height: 28px;
  padding: 0.2rem 0.7rem;
  border: 1px solid var(--global-divider-color);
  border-radius: 999px;
  opacity: 0.8;
}

/* "What's this?" expandable holding the club copy */
.mln-faq {
  margin: 0;
  border: none;
}
/* Styled as a pill so it reads as something you press — as bare text with a
   chevron, people didn't see there was anything to open. */
.mln-faq summary {
  cursor: pointer;
  list-style: none;
  display: inline-flex;
  align-items: center;
  gap: 0.45rem;
  /* matches the chip height so the toggle and the chips share one band */
  min-height: 28px;
  padding: 0.2rem 0.85rem 0.2rem 0.7rem;
  border: 1px solid var(--global-divider-color);
  border-radius: 999px;
  background: var(--global-card-bg-color);
  font-weight: 700;
  font-size: 0.84rem;
  transition: border-color 0.15s ease, color 0.15s ease;
}
.mln-faq summary:hover,
.mln-faq[open] summary {
  border-color: var(--global-theme-color);
  color: var(--global-theme-color);
}
.mln-faq summary::-webkit-details-marker { display: none; }
/* Drawn rather than the "›" glyph: the character's ink sits above its own
   optical centre, so it never lined up with the label at any line-height. A
   bordered square rotated 45° is centred by construction. */
.mln-faq summary::before {
  content: "";
  display: block;
  width: 5px;
  height: 5px;
  margin-right: 0.15rem;
  border-right: 1.5px solid var(--global-theme-color);
  border-bottom: 1.5px solid var(--global-theme-color);
  transform: rotate(-45deg);
  transition: transform 0.15s ease;
}
.mln-faq[open] summary::before { transform: rotate(45deg); }
.mln-faq .mln-about { margin: 0; padding: 1.25rem 0 1.1rem; }

/* about: the club copy, arranged as compact plain-text columns (no cards) */
.mln-about {
  columns: 3 220px;
  column-gap: 2rem;
  margin: 0 0 2rem;
}
.mln-about-sec {
  break-inside: avoid;
  -webkit-column-break-inside: avoid;
  margin: 0 0 1.3rem;
}
.mln-about-h {
  margin: 0 0 0.4rem;
  font-size: 0.72rem;
  font-weight: 700;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  color: var(--global-theme-color);
  font-family: var(--global-code-font-family, monospace);
}
.mln-about-sec p { margin: 0; }
.mln-about-sec ul { margin: 0; padding-left: 1.05rem; }
.mln-about-sec li,
.mln-about-sec p { font-size: 0.9rem; line-height: 1.5; opacity: 0.9; }
.mln-about-sec li { margin-bottom: 0.3rem; }
.mln-about-sec li:last-child { margin-bottom: 0; }
.mln-sched {
  margin: 0;
  font-family: var(--global-code-font-family, monospace);
  font-size: 0.84rem;
}
.mln-sched > div { display: flex; gap: 0.55rem; padding: 0.12rem 0; }
.mln-sched dt { flex: 0 0 4.4rem; font-weight: 700; opacity: 0.9; }
.mln-sched dd { margin: 0; opacity: 0.82; }
@media (max-width: 576px) { .mln-about { columns: 1; } }

/* ── season recap bar ─────────────────────────────────────────────────────
   The reel, as a strip under its season's divider rather than a panel above the
   grid. One mat panel holding two rows: the clickable bar (which opens the reel
   below it) and the season's weeks as a row of covers in polaroid frames.

   Namespaced `mln-reel-`, NOT `mln-recap-`: `.mln-recap` is already the week
   pages' full-width photo figure further down this file, and `.mln-recap img`
   rounds every image inside it to 12px — which reached in here and rounded the
   corners clean off 46px prints.

   Painted in the reel's own palette, not the theme's — this micro-site is pinned
   to a green close enough to the reel's that the video would have no visible
   edge, so the panel is a mat one step darker (#172820, the reel's deeper green)
   with the reel on its true ground (#1b2f24). Hexes are sampled from the file;
   this block deliberately does not track the theme vars. */
.mln-reel-li {
  grid-column: 1 / -1;
  margin: 0.1rem 0 0.35rem;
}
.mln-reel {
  --mln-mat: #172820;
  --mln-ground: #1b2f24;
  --mln-ink: #e9e3d2;
  --mln-khaki: #b6a893;
  border: 1px solid var(--global-divider-color);
  border-radius: 12px;
  background: var(--mln-mat);
  color: var(--mln-ink);
}
.mln-reel-bar {
  cursor: pointer;
  list-style: none;
  display: flex;
  align-items: center;
  gap: 1rem;
  padding: 0.75rem 0.95rem;
  border-radius: 12px 12px 0 0;
  transition: background 0.15s ease;
}
.mln-reel-bar::-webkit-details-marker { display: none; }
.mln-reel-bar:hover { background: #1c3428; }
.mln-reel-bar:focus-visible {
  outline: 2px solid var(--mln-khaki);
  outline-offset: -2px;
}
.mln-reel-meta {
  display: flex;
  flex-direction: column;
  gap: 0.12rem;
  min-width: 0;
  flex: 1 1 auto;
}
.mln-reel-kicker {
  display: flex;
  align-items: center;
  gap: 0.55rem;
  font-family: var(--global-code-font-family, monospace);
  font-size: 0.68rem;
  letter-spacing: 0.15em;
  text-transform: uppercase;
  color: var(--mln-khaki);
}
/* runtime rides on the kicker — it is a fact about the video, not the season */
.mln-reel-len {
  padding-left: 0.55rem;
  border-left: 1px solid rgba(233, 227, 210, 0.25);
  letter-spacing: 0.08em;
  opacity: 0.8;
}
.mln-reel-title {
  font-size: 1.4rem;
  font-weight: 800;
  letter-spacing: -0.02em;
  line-height: 1.1;
  color: var(--mln-ink);
}
/* the reel's own caption card, set the way the reel sets it */
.mln-reel-line {
  font-family: var(--global-code-font-family, monospace);
  font-size: 0.76rem;
  letter-spacing: 0.05em;
  line-height: 1.45;
  color: var(--mln-ink);
  opacity: 0.78;
}
/* A filled button, not a line of text with an arrow: as plain khaki type it read
   as a caption and people didn't know the bar opened. It is decorative markup —
   the whole <summary> is the real click target — so it must never be a <button>
   (nested interactives) and never take the focus ring, which belongs to the bar. */
.mln-reel-cta {
  flex: 0 0 auto;
  display: inline-flex;
  align-items: center;
  gap: 0.45rem;
  min-height: 34px;
  padding: 0 0.9rem;
  border: 1px solid var(--mln-khaki);
  border-radius: 999px;
  background: transparent;
  font-family: var(--global-code-font-family, monospace);
  font-size: 0.74rem;
  font-weight: 700;
  letter-spacing: 0.08em;
  color: var(--mln-khaki);
  white-space: nowrap;
  transition: background 0.15s ease, color 0.15s ease, border-color 0.15s ease, transform 0.15s ease;
}
/* hover is driven off the BAR, not the pill — the whole bar is the hit area, so
   the button has to light up wherever on it the pointer actually is */
.mln-reel-bar:hover .mln-reel-cta,
.mln-reel-bar:focus-visible .mln-reel-cta {
  background: var(--mln-khaki);
  border-color: var(--mln-khaki);
  color: #17281f;
  transform: translateY(-1px);
}
.mln-reel-cta-close { display: none; }
.mln-reel-fold[open] .mln-reel-cta-open { display: none; }
.mln-reel-fold[open] .mln-reel-cta-close { display: inline-flex; align-items: center; gap: 0.45rem; }
/* the play glyph is the other half of "this opens something". The label is a
   plain span, so the pill's own flex gap doesn't apply between glyph and text —
   inline-flex it and give it its own. */
.mln-reel-cta-open {
  display: inline-flex;
  align-items: center;
  gap: 0.45rem;
}
.mln-reel-cta-open::before {
  content: "▶";
  font-size: 0.62rem;
  line-height: 1;
}
.mln-reel-cta .mln-arrow { transition: transform 0.15s ease; }
.mln-reel-bar:hover .mln-reel-cta .mln-arrow { transform: translateY(2px); }
.mln-reel-fold[open] .mln-reel-bar:hover .mln-reel-cta .mln-arrow { transform: translateY(-2px); }

.mln-reel-body {
  display: flex;
  justify-content: center;
  padding: 0.35rem 0.95rem 1.1rem;
}
.mln-reel-fold[open] .mln-reel-bar { border-bottom: 1px solid rgba(233, 227, 210, 0.14); }
.mln-reel-frame {
  margin: 0;
  width: 100%;
}
/* The wide cut, so this is width-driven and 16:9 — it fills the mat the way the
   bar above it does. The ratio comes from the element's own width/height attrs
   (keep them in step with the file: a stale 9:16 pair there beat `aspect-ratio`
   here and the frame came out square). Height is still capped for short
   landscape windows, with object-fit so that cap letterboxes rather than
   stretches. */
.mln-reel-frame video {
  display: block;
  width: 100%;
  height: auto;
  max-height: 74vh;
  object-fit: contain;
  border-radius: 10px;
  background: var(--mln-ground);
  box-shadow: 0 10px 30px rgba(0, 0, 0, 0.35);
}

/* The season's weeks, as prints laid along the bottom of the mat: each is the
   week's own Luma cover — the same art as its card below, so the row is an
   index you can recognise rather than decoration — with the week number in the
   polaroid's chin, where a print carries its label.

   Its own row, clear of the bar above it, and outside the <summary> so these
   links stay clickable without toggling the reel. */
.mln-reel-strip {
  display: flex;
  flex-wrap: wrap;
  gap: 0.45rem;
  padding: 0.85rem 0.95rem 0.95rem;
  border-top: 1px solid rgba(233, 227, 210, 0.14);
}
.mln-reel-pola {
  display: block;
  flex: 0 0 auto;
  width: 52px;
  /* only the chin — the cover runs the full width of the print, edge to edge */
  padding: 0 0 2px;
  border-radius: 2px;
  overflow: hidden;
  background: var(--mln-ink);
  text-decoration: none;
  box-shadow: 0 2px 7px rgba(0, 0, 0, 0.4);
  /* a print dropped on a board, not a thumbnail in a grid — every other one
     leans the other way so the row reads as hand-laid */
  transform: rotate(-2deg);
  transition: transform 0.18s ease, box-shadow 0.18s ease;
}
.mln-reel-pola:nth-child(even) { transform: rotate(2deg); }
.mln-reel-pola:hover,
.mln-reel-pola:focus-visible {
  text-decoration: none;
  transform: rotate(0deg) translateY(-3px) scale(1.06);
  box-shadow: 0 7px 16px rgba(0, 0, 0, 0.45);
}
.mln-reel-pola-img {
  display: block;
  overflow: hidden;
  background: var(--mln-ground);
  aspect-ratio: 1 / 1;
}
/* Two things this has to undo, both from al-folio's global stylesheet:

   `border-radius` — bare `img` is rounded to 12px site-wide, which on a 46px
   print rounds the corners clean off. A photograph has square corners.

   The ratio is carried by the img ITSELF, not just the box: `height: 100%`
   against a parent sized only by `aspect-ratio` collapsed for some covers and
   the prints came out at mixed heights. */
.mln-reel-pola-img img {
  display: block;
  width: 100%;
  height: auto;
  aspect-ratio: 1 / 1;
  object-fit: cover;
  border-radius: 0;
}
/* the chin — a polaroid's white strip is where the label goes, so the week
   number lives there rather than as a tick of its own */
.mln-reel-pola-num {
  display: block;
  padding-top: 2px;
  font-family: var(--global-code-font-family, monospace);
  font-size: 0.6rem;
  line-height: 1.5;
  letter-spacing: 0.06em;
  text-align: center;
  /* ink on the print, not on the mat — this sits on the cream chin */
  color: #4a4436;
}

/* Narrow: the cta drops (open/shut is legible from the reel itself) and the
   prints shrink so a phone still gets more than two to a row. */
/* Narrow: the button stays — it is the affordance — and wraps under the type
   rather than being dropped. */
@media (max-width: 640px) {
  .mln-reel-bar {
    flex-wrap: wrap;
    gap: 0.7rem;
  }
  .mln-reel-cta { width: 100%; justify-content: center; }
  .mln-reel-title { font-size: 1.2rem; }
  .mln-reel-strip { gap: 0.4rem; }
  .mln-reel-pola { width: 46px; }
}

/* ── season divider in the week grid ──────────────────────────────────────
   A full-width row that heads every card under it. Spans the whole grid rather
   than sitting in a column, so the archive reads as labelled runs of weeks
   instead of one undifferentiated wall of cards.

   The li itself is a plain block with a flex inner: `.mln-far-week` is toggled
   with `display: block`, so a flex li would lose its layout the moment the
   dropdown revealed it. */
.mln-grid-season {
  grid-column: 1 / -1;
  margin: 1.15rem 0 0.1rem;
}
.mln-grid-season:first-child { margin-top: 0.15rem; }
.mln-grid-season-inner {
  display: flex;
  align-items: center;
  gap: 0.8rem;
}
/* set like the cards' own WEEK slug, so the heading reads as part of the grid's
   language rather than as page furniture dropped between rows */
.mln-grid-season-name {
  margin: 0;
  font-family: var(--global-code-font-family, monospace);
  font-size: 0.82rem;
  font-weight: 700;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  white-space: nowrap;
  color: var(--global-text-color);
}
.mln-grid-season-line {
  flex: 1 1 auto;
  height: 1px;
  min-width: 1rem;
  background: var(--global-divider-color);
}
.mln-grid-season-state {
  flex: 0 0 auto;
  font-family: var(--global-code-font-family, monospace);
  font-size: 0.7rem;
  letter-spacing: 0.13em;
  text-transform: uppercase;
  opacity: 0.6;
}
/* the running season carries the same lit dot the recap band's rail uses — one
   marker for "this is the phase the club is in", used in both places */
.mln-grid-season-state.is-now {
  display: inline-flex;
  align-items: center;
  gap: 0.42rem;
  color: var(--global-theme-color);
  opacity: 1;
}
.mln-grid-season-state.is-now::before {
  content: "";
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: var(--global-theme-color);
}

/* week grid */
.mln-grid {
  list-style: none;
  padding: 0;
  margin: 0;
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(290px, 1fr));
  gap: 0.85rem;
}
.mln-grid li { margin: 0; }

.mln-card {
  position: relative;
  display: flex;
  flex-direction: column;
  height: 100%;
  border: 1px solid var(--global-divider-color);
  border-radius: 12px;
  color: inherit;
  text-decoration: none;
  background: transparent;
  overflow: hidden;
  transition: border-color 0.15s ease, background 0.15s ease, transform 0.15s ease, box-shadow 0.15s ease;
}
