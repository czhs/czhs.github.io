---
layout: mln_base
---

{% assign w = site.data.mln.weeks | where: "num", page.week | first %}

<div class="post">
  <a class="mln-back" href="{{ '/mln/' | relative_url }}">← all weeks</a>

  <header class="mln-detail-head post-header">
    <div class="mln-detail-eyebrow">MLn CLUB · WEEK {{ w.num }}{% if w.symposium %} · 🎉 SYMPOSIUM{% endif %}</div>
    <h1 class="post-title">{{ w.title }}</h1>
  </header>

  <div class="mln-detail-grid">
    <div class="mln-resources">
      {% if w.reading %}
      <h2>Reading</h2>
      <ul class="mln-reading">
        {% for r in w.reading %}<li><a href="{{ r.url }}" target="_blank" rel="noopener">{{ r.title }}</a></li>{% endfor %}
      </ul>
      {% endif %}

      {% if w.recording %}
      <h2>Paper audio</h2>
      <audio class="mln-recording" controls preload="none" src="{{ w.recording | relative_url }}"></audio>
      {% endif %}

      <h2>About this week</h2>
      {% if w.description %}
      <div class="mln-desc">{{ w.description | markdownify }}</div>
      {% elsif w.coming_soon %}
      <div class="mln-desc"><p>We haven’t picked this week’s paper yet. Check back soon — or come suggest one!</p></div>
      {% endif %}

      {{ content }}
    </div>

    <aside class="mln-embed">
      {% if w.evt %}
      <iframe
        src="https://lu.ma/embed/event/{{ w.evt }}/simple"
        allowfullscreen
        aria-hidden="false"
        tabindex="0"
        title="{{ w.title }} on Luma"></iframe>
      <p class="mln-embed-fallback">
        Trouble loading? <a href="https://luma.com/{{ w.slug }}" target="_blank" rel="noopener">open this event on Luma ↗</a>
      </p>
      {% else %}
      <div class="mln-embed-fallback">
        <p>This week’s session isn’t scheduled yet.</p>
        <p><a href="{{ site.data.mln.calendar_url }}" target="_blank" rel="noopener">Follow the calendar on Luma ↗</a></p>
      </div>
      {% endif %}
      {% if site.data.mln.contact_url %}
      <a class="mln-feedback" href="{{ site.data.mln.contact_url }}" target="_blank" rel="noopener">
        Have feedback on this session? Share it ↗
      </a>
      {% endif %}
    </aside>
  </div>
</div>

{%- if w.symposium -%}
  {% include mln_confetti.liquid %}
{%- endif -%}
