<!doctype html>
<html lang="{{ site.lang }}">
  <!-- Head -->
  <head>
    {% if page.redirect %}
      {% if page.redirect == true %}
        {% assign redirect = site.baseurl | append: '/' %}
      {% elsif page.redirect contains '://' %}
        {% assign redirect = page.redirect %}
      {% else %}
        {% assign redirect = page.redirect | relative_url %}
      {% endif %}
      <meta http-equiv="refresh" content="3; url={{ redirect }}">
    {% endif %}
    {% include head.liquid %}
    {%- comment -%}
      Both of these MUST stay in <head>. With the skin at the top of <body> the
      browser painted al-folio's cream/green theme first and repainted to the
      zine palette a frame later — a colour flash on every navigation.
    {%- endcomment -%}
    {% include zine_palette.liquid %}
    {% include zine_styles.liquid %}
  </head>

  <!-- Body -->
  {%- comment -%}
    rzine-page carries the /research zine treatment out to the shared chrome
    (navbar, footer, theme toggle) — see _includes/research_styles.liquid.
  {%- endcomment -%}
  <body class="{% if site.navbar_fixed %}fixed-top-nav{% endif %} {% unless site.footer_fixed %}sticky-bottom-footer{% endunless %} zine {% if page.layout contains 'research' or page.rzine %}rzine-page{% endif %}">
    <!-- Header -->
    {% include header.liquid %}

    <!-- Content -->
    <div class="container mt-5" role="main">
      {% if page.toc and page.toc.sidebar %}
        {% if page.toc.sidebar == 'right' %}
          <div class="row">
            <!-- main content area -->
            <div class="col-sm-9">{{ content }}</div>
            <!-- sidebar, which will move to the top on a small screen -->
            <div class="col-sm-3">
              <nav id="toc-sidebar" class="sticky-top"></nav>
            </div>
          </div>
        {% else %}
          <div class="row">
            <!-- sidebar, which will move to the top on a small screen -->
            <div class="col-sm-3">
              <nav id="toc-sidebar" class="sticky-top"></nav>
            </div>
            <!-- main content area -->
            <div class="col-sm-9">{{ content }}</div>
          </div>
        {% endif %}
      {% else %}
        {{ content }}
      {% endif %}
    </div>

    <!-- Footer -->
    {% include footer.liquid %}
    {% unless page.rzine or page.layout contains 'research' %}{% include zine_foot.liquid %}{% endunless %}

    <!-- JavaScripts -->
    {% include scripts.liquid %}
  </body>
</html>
