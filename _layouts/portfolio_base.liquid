<!doctype html>
<html lang="{{ site.lang }}">
  <head>
    {% include head.liquid %}
    <!-- Self-hosted fonts (same files as the main site) — preloaded so the
         metric-matched fallback swap in portfolio_styles is invisible. -->
    <link rel="preload" as="font" type="font/woff2" crossorigin href="{{ '/assets/fonts/plus-jakarta-sans-latin-var.woff2' | relative_url }}">
    <link rel="preload" as="font" type="font/woff2" crossorigin href="{{ '/assets/fonts/jetbrains-mono-latin-var.woff2' | relative_url }}">
    {% include portfolio_styles.liquid %}
    <script>
      // head.liquid's theme.js has just applied the VISITOR's theme (system
      // preference by default). This sheet has one fixed palette, so pin the
      // computed theme to light here: otherwise a dark-mode visitor gets the
      // dark syntax-highlight stylesheet and Bootstrap's .table-dark stamped
      // on every table — white text on ivory. theme.js declares these with
      // `let` at top level, so a later classic script can reassign them.
      if (typeof determineComputedTheme === 'function' && typeof applyTheme === 'function') {
        determineComputedTheme = function () {
          return 'light';
        };
        applyTheme();
      }
    </script>
  </head>

  <body class="rbx-site">
    <script>
      // Arm the reveal choreography before first paint — and only when motion
      // is allowed, so without JS or with reduced motion nothing is hidden.
      (function () {
        if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
          document.documentElement.classList.add('rbx-armed');
        }
      })();
    </script>

    <div class="rbx-window" aria-hidden="true"></div>

    {{ content }}

    <!-- Hidden theme toggle: al-folio's theme.js wires listeners to these IDs on load.
         This standalone micro-site has no navbar, so we keep them present but hidden
         to avoid a null-addEventListener crash that would halt all page JS. -->
    <button id="light-toggle" title="Change theme" style="display: none;" aria-hidden="true">
      <i class="ti ti-sun-moon" id="light-toggle-system"></i>
      <i class="ti ti-moon-filled" id="light-toggle-dark"></i>
      <i class="ti ti-sun-filled" id="light-toggle-light"></i>
    </button>

    <script>
      // Reveal-on-scroll, shared by the index and the detail pages. Elements
      // rise in once as they reach the viewport.
      (function () {
        var doc = document.documentElement;
        if (!doc.classList.contains('rbx-armed')) return;
        doc.classList.add('rbx-ready');
        var els = [].slice.call(document.querySelectorAll('[data-rv], .rbx-stn, .rbx-shot, .rbx-pager'));
        if (!els.length || !('IntersectionObserver' in window)) {
          doc.classList.remove('rbx-armed');
          return;
        }
        var io = new IntersectionObserver(
          function (entries) {
            entries.forEach(function (en) {
              if (!en.isIntersecting) return;
              en.target.classList.add('is-in');
              io.unobserve(en.target);
            });
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.05 }
        );
        els.forEach(function (el) {
          io.observe(el);
        });
        // Content injected after load (the unlocked b-roll gallery) carries the
        // same reveal classes, so it starts hidden too — and nothing would ever
        // observe it. Anything that injects such markup dispatches this event
        // with the new root, and the observer picks its children up.
        document.addEventListener('rbx:reveal', function (e) {
          var root = (e.detail && e.detail.root) || document;
          root.querySelectorAll('[data-rv], .rbx-stn, .rbx-shot, .rbx-pager').forEach(function (el) {
            if (!el.classList.contains('is-in')) io.observe(el);
          });
        });
      })();
    </script>

    {% include scripts.liquid %}
  </body>
</html>
