<!doctype html>
<html lang="{{ site.lang }}">
  <head>
    {% include head.liquid %}
    {% include mln_styles.liquid %}
  </head>

  <body class="mln-site">
    <header class="mln-masthead">
      <div class="mln-shell mln-masthead-inner">
        <a class="mln-brand" href="{{ '/mln/' | relative_url }}" aria-label="MLn Reading Club — home">
          <span class="mln-brand-ring" aria-hidden="true"></span>
          <span class="mln-brand-mark" aria-hidden="true"></span>
        </a>
        {%- comment -%}
          The sibling pill is the LAST nav item on both micro-sites, and both
          mastheads share a shell width and height, so the two clubs' marks land
          on exactly the same pixel — click through and the link you just used is
          under your cursor again.
        {%- endcomment -%}
        <nav class="mln-topnav">
          <a href="{{ site.data.mln.calendar_url }}?utm_source=czhs" target="_blank" rel="noopener">Luma ↗</a>
          {%- comment -%}
            The label is ringworld's own hand lettering, not type — same rule as
            both brands. It is an alpha mask over the pill's colour, so the
            accessible name comes from aria-label rather than from text.
          {%- endcomment -%}
          <a class="mln-sibling" href="{{ '/ringworld/' | relative_url }}" aria-label="ringworld — the sibling maker space">
            <img class="mln-sibling-ico" src="{{ '/assets/img/ringworld/mark.png' | relative_url }}" alt="" aria-hidden="true" width="480" height="263" />
            <span class="mln-sibling-mark" aria-hidden="true"></span>
          </a>
        </nav>
      </div>
    </header>

    {%- comment -%}
      Announcement band, driven by `notice:` in _data/mln.yml. It renders on
      every page of the micro-site — most people arrive on a week page from a
      Luma link, not on the landing page — and only while the build date is on
      or before `expires`, so a stale notice can't outlive its news. It sits
      BELOW the sticky masthead and scrolls away with the page rather than
      pinning a second permanent band to the top of every screen.
    {%- endcomment -%}
    {%- assign notice = site.data.mln.notice -%}
    {%- assign build_day = site.time | date: "%Y-%m-%d" -%}
    {%- if notice.text and notice.text != "" and build_day <= notice.expires -%}
      <aside class="mln-notice-band" aria-label="Club announcement">
        <p class="mln-shell mln-notice">
          <span class="mln-notice-tag">new</span>
          <span>{{ notice.text }}</span>
        </p>
      </aside>
    {%- endif -%}

    <main class="mln-shell mln-main" role="main">
      {{ content }}
    </main>

    <footer class="mln-foot">
      <div class="mln-shell mln-foot-inner">
        <span class="mln-foot-name">MLn Reading Club</span>
        <span class="mln-foot-dot">·</span>
        <span>Pittsburgh · Sundays 7–9pm</span>
        <a class="mln-foot-by" href="{{ '/' | relative_url }}">by Chris Shi</a>
      </div>
    </footer>

    <!-- Hidden theme toggle: al-folio's theme.js wires listeners to these IDs on load.
         This micro-site's masthead has no toggle, so we keep them present but hidden
         to avoid a null-addEventListener crash that would halt all page JS. -->
    <button id="light-toggle" title="Change theme" style="display: none;" aria-hidden="true">
      <i class="ti ti-sun-moon" id="light-toggle-system"></i>
      <i class="ti ti-moon-filled" id="light-toggle-dark"></i>
      <i class="ti ti-sun-filled" id="light-toggle-light"></i>
    </button>

    {% include scripts.liquid %}
  </body>
</html>
